  file_change {
    absolute_path_uri: "file:///src/components/CustomCursor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useEffect, useState, useRef } from \'react\';\nimport { motion, useMotionValue, useSpring } from \'motion/react\';\n\nexport default function CustomCursor() {\n  const [visible, setVisible] = useState(false);\n  const [hoveredState, setHoveredState] = useState<\'default\' | \'expand\' | \'logo\' | \'card\'>(\'default\');\n  const cursorRef = useRef<HTMLDivElement | null>(null);\n\n  // Motion values for smooth cursor trailing\n  const cursorX = useMotionValue(-100);\n  const cursorY = useMotionValue(-100);\n\n  const springConfig = { damping: 25, stiffness: 220, mass: 0.6 };\n  const cursorXSpring = useSpring(cursorX, springConfig);\n  const cursorYSpring = useSpring(cursorY, springConfig);\n\n  useEffect(() => {\n    // Check if the user is on a device with a mouse\n    const mediaQuery = window.matchMedia(\'(pointer: fine)\');\n    if (!mediaQuery.matches) return;\n\n    setVisible(true);\n\n    const moveCursor = (e: MouseEvent) => {\n      cursorX.set(e.clientX - 6);\n      cursorY.set(e.clientY - 6);\n    };\n\n    const handleMouseLeave = () => setVisible(false);\n    const handleMouseEnter = () => setVisible(true);\n\n    window.addEventListener(\'mousemove\', moveCursor);\n    document.addEventListener(\'mouseleave\', handleMouseLeave);\n    document.addEventListener(\'mouseenter\', handleMouseEnter);\n\n    // Dynamic hover listeners\n    const addHoverListeners = () => {\n      const expandTargets = document.querySelectorAll(\'button, a, input, select, textarea, [role=\"button\"], .hover-expand\');\n      const logoTargets = document.querySelectorAll(\'.hover-logo\');\n      const cardTargets = document.querySelectorAll(\'.hover-card-glow\');\n\n      expandTargets.forEach((el) => {\n        el.addEventListener(\'mouseenter\', () => setHoveredState(\'expand\'));\n        el.addEventListener(\'mouseleave\', () => setHoveredState(\'default\'));\n      });\n\n      logoTargets.forEach((el) => {\n        el.addEventListener(\'mouseenter\', () => setHoveredState(\'logo\'));\n        el.addEventListener(\'mouseleave\', () => setHoveredState(\'default\'));\n      });\n\n      cardTargets.forEach((el) => {\n        el.addEventListener(\'mouseenter\', () => setHoveredState(\'card\'));\n        el.addEventListener(\'mouseleave\', () => setHoveredState(\'default\'));\n      });\n    };\n\n    // Set initial listeners\n    addHoverListeners();\n\n    // Use a MutationObserver to watch for dynamically added DOM elements (like tickets or step transitions)\n    const observer = new MutationObserver(addHoverListeners);\n    observer.observe(document.body, { childList: true, subtree: true });\n\n    return () => {\n      window.removeEventListener(\'mousemove\', moveCursor);\n      document.removeEventListener(\'mouseleave\', handleMouseLeave);\n      document.removeEventListener(\'mouseenter\', handleMouseEnter);\n      observer.disconnect();\n    };\n  }, [cursorX, cursorY]);\n\n  if (!visible) return null;\n\n  // Custom styling sizes based on state\n  const sizes = {\n    default: { width: 14, height: 14, scale: 1, backgroundColor: \'rgba(120, 45, 255, 0.5)\', borderWidth: \'0px\' },\n    expand: { width: 44, height: 44, scale: 1.2, backgroundColor: \'rgba(120, 45, 255, 0.08)\', borderWidth: \'1px\', borderColor: \'#782DFF\' },\n    logo: { width: 56, height: 56, scale: 1.3, backgroundColor: \'rgba(255, 32, 190, 0.06)\', borderWidth: \'1.5px\', borderColor: \'#FF20BE\' },\n    card: { width: 24, height: 24, scale: 1.1, backgroundColor: \'rgba(32, 156, 255, 0.25)\', borderWidth: \'0px\' },\n  };\n\n  const currentStyle = sizes[hoveredState];\n\n  return (\n    <>\n      {/* Outer Spring Follower Orb */}\n      <motion.div\n        ref={cursorRef}\n        id=\"custom-cursor\"\n        className=\"fixed top-0 left-0 rounded-full pointer-events-none z-[10000] mix-blend-difference flex items-center justify-center transition-shadow duration-300\"\n        style={{\n          x: cursorXSpring,\n          y: cursorYSpring,\n          width: currentStyle.width,\n          height: currentStyle.height,\n          backgroundColor: currentStyle.backgroundColor,\n          border: currentStyle.borderWidth !== \'0px\' ? `${currentStyle.borderWidth} solid ${currentStyle.borderColor}` : \'none\',\n          boxShadow: hoveredState === \'logo\' ? \'0 0 15px rgba(255, 32, 190, 0.4)\' : hoveredState === \'expand\' ? \'0 0 10px rgba(120, 45, 255, 0.2)\' : \'none\',\n        }}\n        animate={{\n          scale: currentStyle.scale,\n        }}\n        transition={{\n          type: \'spring\',\n          damping: 28,\n          stiffness: 300,\n        }}\n      >\n        {/* Core Dot inside cursor */}\n        {hoveredState === \'default\' && (\n          <div className=\"w-1.5 h-1.5 bg-white rounded-full\" />\n        )}\n      </motion.div>\n    </>\n  );\n}\n"
    }
