          text: "    // Populate mock data if database is empty to make experience amazing immediately"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    localStorage.setItem(STORAGE_KEY, JSON.stringify(MOCK_ATTENDEES));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return MOCK_ATTENDEES;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
