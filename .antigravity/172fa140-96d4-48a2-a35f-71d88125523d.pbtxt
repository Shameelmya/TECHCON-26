    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport { \n  Brain, ShieldAlert, Zap, Cpu, Share2, Code, \n  FileSearch, Briefcase, ChevronRight, Activity, \n  Lock, Terminal, Radio, Network, Lightbulb, GraduationCap \n} from \'lucide-react\';\n\nexport default function WhyAttend() {\n  const cards = [\n    {\n      icon: <Brain className=\"text-brand-pink\" size={24} />,\n      badge: \"ALGORITHMS\",\n      title: \'Artificial Intelligence & ML\',\n      subtitle: \'Explore generative neural nets, deep learning compilers, and real-time edge execution pipelines.\',\n      color: \'from-brand-pink/10 to-transparent\',\n      borderColor: \'group-hover:border-brand-pink/40\',\n      glow: \'shadow-[0_0_30px_rgba(255,32,142,0.15)]\',\n      stats: \'12 SESSIONS\',\n      bgPulse: \'bg-brand-pink/20\'\n    },\n    {\n      icon: <Lock className=\"text-brand-purple\" size={24} />,\n      badge: \"SECURITY\",\n      title: \'Cyber Security & Cryptography\',\n      subtitle: \'Zero-trust networks, web3 security models, privacy-preserving techniques, and modern exploitation labs.\',\n      color: \'from-brand-purple/10 to-transparent\',\n      borderColor: \'group-hover:border-brand-purple/40\',\n      glow: \'shadow-[0_0_30px_rgba(120,45,255,0.15)]\',\n      stats: \'8 WORKSHOPS\',\n      bgPulse: \'bg-brand-purple/20\'\n    },\n    {\n      icon: <Lightbulb className=\"text-amber-400\" size={24} />,\n      badge: \"INCUBATOR\",\n      title: \'Innovation Lab\',\n      subtitle: \'Witness the metamorphosis of bold technology concepts into scalable and impactful real-world tools.\',\n      color: \'from-amber-400/10 to-transparent\',\n      borderColor: \'group-hover:border-amber-400/40\',\n      glow: \'shadow-[0_0_30px_rgba(245,158,11,0.15)]\',\n      stats: \'DEMO STAGE\',\n      bgPulse: \'bg-amber-400/20\'\n    },\n    {\n      icon: <Cpu className=\"text-brand-blue\" size={24} />,\n      badge: \"HARDWARE\",\n      title: \'Embedded Robotics\',\n      subtitle: \'Sensory telemetry networks, industrial microcontrollers, autonomous system navigation, and spatial AI.\',\n      color: \'from-brand-blue/10 to-transparent\',\n      borderColor: \'group-hover:border-brand-blue/40\',\n      glow: \'shadow-[0_0_30px_rgba(32,156,255,0.15)]\',\n      stats: \'PHYSICAL EXHIBITS\',\n      bgPulse: \'bg-brand-blue/20\'\n    },\n    {\n      icon: <Network className=\"text-indigo-400\" size={24} />,\n      badge: \"DECENTRALIZED\",\n      title: \'Network & Connectivity\',\n      subtitle: \'Low-latency mesh systems, high-throughput cloud streaming, decentralized ledgers, and edge nodes.\',\n      color: \'from-indigo-400/10 to-transparent\',\n      borderColor: \'group-hover:border-indigo-400/40\',\n      glow: \'shadow-[0_0_30px_rgba(129,140,248,0.15)]\',\n      stats: \'6 PANEL DEBATES\',\n      bgPulse: \'bg-indigo-400/20\'\n    },\n    {\n      icon: <Code className=\"text-emerald-400\" size={24} />,\n      badge: \"SYSTEMS\",\n      title: \'Modern Engineering\',\n      subtitle: \'Advanced systems programming (Rust/Go), distributed systems, and real-time database streaming.\',\n      color: \'from-emerald-400/10 to-transparent\',\n      borderColor: \'group-hover:border-emerald-400/40\',\n      glow: \'shadow-[0_0_30px_rgba(52,211,153,0.15)]\',\n      stats: \'LIVE CODING\',\n      bgPulse: \'bg-emerald-400/20\'\n    },\n    {\n      icon: <GraduationCap className=\"text-cyan-400\" size={24} />,\n      badge: \"ACADEMIA\",\n      title: \'Academic Research\',\n      subtitle: \'Reviewing cutting-edge research abstracts, student thesis presentations, and peer-reviewed journals.\',\n      color: \'from-cyan-400/10 to-transparent\',\n      borderColor: \'group-hover:border-cyan-400/40\',\n      glow: \'shadow-[0_0_30px_rgba(34,211,238,0.15)]\',\n      stats: \'15 ABSTRACTS\',\n      bgPulse: \'bg-cyan-400/20\'\n    },\n    {\n      icon: <Briefcase className=\"text-rose-400\" size={24} />,\n      badge: \"STARTUP\",\n      title: \'Future Tech Careers\',\n      subtitle: \'Dedicated hiring booths, resume workshops, startup pitching battles, and networking lounges.\',\n      color: \'from-rose-400/10 to-transparent\',\n      borderColor: \'group-hover:border-rose-400/40\',\n      glow: \'shadow-[0_0_30px_rgba(251,113,133,0.15)]\',\n      stats: \'RECRUITERS STALL\',\n      bgPulse: \'bg-rose-400/20\'\n    },\n  ];\n\n  return (\n    <section \n      id=\"why-attend\" \n      className=\"py-24 sm:py-32 bg-brand-dark border-t border-slate-900 px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* High-Tech Grid Overlays */}\n      <div \n        className=\"absolute inset-0 pointer-events-none opacity-[0.03]\" \n        style={{\n          backgroundImage: `linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px)`,\n          backgroundSize: \'40px 40px\'\n        }}\n      />\n\n      {/* Futuristic soft gradient background glows */}\n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-brand-purple/15 to-brand-pink/10 blur-[140px] -top-40 -left-20 pointer-events-none\" />\n      <div className=\"absolute w-[600px] h-[600px] rounded-full bg-gradient-to-br from-brand-blue/10 to-brand-purple/15 blur-[160px] -bottom-40 -right-20 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        \n        {/* Header Title with futuristic brand layout */}\n        <div className=\"text-center max-w-2xl mx-auto mb-20\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-brand-purple/10 border border-brand-purple/20 rounded-full mb-4\">\n            <Activity size={12} className=\"text-brand-purple animate-pulse\" />\n            <span className=\"text-[10px] font-mono tracking-[0.2em] text-brand-purple uppercase font-bold\">\n              CONFERENCE INTEGRITY\n            </span>\n          </div>\n          \n          <h2 className=\"text-4xl sm:text-5xl font-orbitron font-extrabold tracking-tight text-white mb-5 uppercase\">\n            Syllabus & Tracks\n          </h2>\n          \n          <p className=\"text-xs sm:text-sm font-sans text-slate-400 leading-relaxed max-w-xl mx-auto\">\n            TECHCON \'26 tracks are meticulously segmented across eight high-impact sectors, reflecting the core architectural foundations of international digital engineering.\n          </p>\n        </div>\n\n        {/* Dynamic Bento Cards Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {cards.map((card, i) => (\n            <motion.div\n              key={i}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 0.5, delay: i * 0.05 }}\n              className={`group relative p-6 bg-brand-navy/40 backdrop-blur-md rounded-3xl border border-slate-800/80 hover:border-slate-700/80 transition-all duration-300 hover:-translate-y-1.5 hover:${card.glow} overflow-hidden flex flex-col justify-between`}\n            >\n              {/* Inner floating soft gradient background blob */}\n              <div className={`absolute inset-0 bg-gradient-to-b ${card.color} opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none`} />\n\n              {/* Glowing micro circuit design in card corner */}\n              <div className=\"absolute right-0 top-0 opacity-[0.02] text-white pointer-events-none select-none\">\n                <svg viewBox=\"0 0 100 100\" className=\"w-24 h-24\">\n                  <path d=\"M 50,0 L 50,50 L 100,50\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" />\n                  <circle cx=\"50\" cy=\"50\" r=\"4\" fill=\"currentColor\" />\n                </svg>\n              </div>\n\n              <div className=\"relative z-10\">\n                {/* Tech Code Block Badge */}\n                <div className=\"flex items-center justify-between mb-6\">\n                  <span className=\"font-mono text-[9px] font-bold tracking-[0.2em] text-slate-500 group-hover:text-brand-blue transition-colors\">\n                    //{card.badge}\n                  </span>\n                  \n                  {/* Glowing small pulse */}\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className={`w-1.5 h-1.5 rounded-full ${card.bgPulse} relative flex items-center justify-center`}>\n                      <span className={`absolute w-1 h-1 rounded-full ${card.bgPulse.replace(\'/20\', \'\')} animate-ping`} />\n                    </span>\n                    <span className=\"font-mono text-[8px] tracking-wider text-slate-500 uppercase\">{card.stats}</span>\n                  </div>\n                </div>\n\n                {/* Custom glowing icon plate */}\n                <div className=\"w-12 h-12 rounded-2xl bg-brand-navy border border-slate-800 flex items-center justify-center mb-6 group-hover:scale-105 group-hover:bg-slate-900 transition-all duration-300\">\n                  {card.icon}\n                </div>\n\n                <h3 className=\"text-base font-orbitron font-bold text-slate-100 group-hover:text-white transition-colors mb-2.5 uppercase tracking-wide\">\n                  {card.title}\n                </h3>\n\n                <p className=\"text-xs sm:text-[13px] font-sans text-slate-400 leading-relaxed mb-6 group-hover:text-slate-300 transition-colors\">\n                  {card.subtitle}\n                </p>\n              </div>\n\n              {/* High tech detail line at bottom of card */}\n              <div className=\"relative z-10 flex items-center justify-between border-t border-slate-900/80 pt-4 mt-2\">\n                <div className=\"flex items-center gap-1.5 text-[10px] font-mono font-bold text-slate-500 group-hover:text-brand-purple transition-colors\">\n                  <span>SYSTEM_ID // 0{i + 1}</span>\n                </div>\n                \n                <div className=\"flex items-center text-slate-600 group-hover:text-white transition-colors\">\n                  <ChevronRight size={14} className=\"group-hover:translate-x-1 transition-transform\" />\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Brand Concept callout inside section */}\n        <div className=\"mt-20 flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-slate-500 border-t border-slate-900/60 pt-10\">\n          <div className=\"flex items-center gap-2 bg-brand-navy/30 px-3 py-1.5 rounded-xl border border-slate-900/40\">\n            <Terminal size={12} className=\"text-brand-pink\" />\n            <span>LATENCY: ZERO_LAG_TRANSMISSIONS</span>\n          </div>\n          <div className=\"flex items-center gap-2 bg-brand-navy/30 px-3 py-1.5 rounded-xl border border-slate-900/40\">\n            <Radio size={12} className=\"text-brand-purple\" />\n            <span>NODES: DECENTRALIZED_NETWORKS</span>\n          </div>\n          <div className=\"flex items-center gap-2 bg-brand-navy/30 px-3 py-1.5 rounded-xl border border-slate-900/40\">\n            <Cpu size={12} className=\"text-brand-blue\" />\n            <span>CORES: QUANTUM_COMPUTATIONAL_UNITS</span>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
