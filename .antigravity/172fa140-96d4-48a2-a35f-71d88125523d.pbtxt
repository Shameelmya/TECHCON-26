  file_change {
    absolute_path_uri: "file:///src/components/AdminDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Lock, CheckCircle, XCircle, Search, LogOut, Download, \n  Send, Users, QrCode, ClipboardList, Shield, RefreshCw, BarChart3, PieChart\n} from \'lucide-react\';\nimport { AttendeeRegistration, AdminStats } from \'../types\';\nimport { getRegistrations, getStats, checkInAttendee, revertCheckIn, exportToCSV } from \'../utils/db\';\n\ninterface AdminDashboardProps {\n  onClose: () => void;\n}\n\nexport default function AdminDashboard({ onClose }: AdminDashboardProps) {\n  const [isAuthenticated, setIsAuthenticated] = useState(false);\n  const [password, setPassword] = useState(\'\');\n  const [loginError, setLoginError] = useState(\'\');\n\n  // Dashboard Stats\n  const [stats, setStats] = useState<AdminStats | null>(null);\n  const [attendees, setAttendees] = useState<AttendeeRegistration[]>([]);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [activeTab, setActiveTab] = useState<\'analytics\' | \'checkin\' | \'directory\'>(\'analytics\');\n\n  // Scanning / Check-in Console State\n  const [scannerInput, setScannerInput] = useState(\'\');\n  const [scannerResult, setScannerResult] = useState<{ success: boolean; msg: string } | null>(null);\n\n  // Volunteer Mode Feature (hides deep exports)\n  const [isVolunteerMode, setIsVolunteerMode] = useState(false);\n\n  useEffect(() => {\n    if (isAuthenticated) {\n      loadData();\n    }\n  }, [isAuthenticated]);\n\n  const loadData = () => {\n    const list = getRegistrations();\n    setAttendees(list);\n    setStats(getStats());\n  };\n\n  const handleLogin = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginError(\'\');\n    \n    // Check credentials (secure gate passcode)\n    if (password === \'TECHCON2026\' || password === \'techcon2026\' || password === \'volunteer\') {\n      if (password.toLowerCase() === \'volunteer\') {\n        setIsVolunteerMode(true);\n      }\n      setIsAuthenticated(true);\n    } else {\n      setLoginError(\'Invalid Administrator Passcode. Please try again.\');\n    }\n  };\n\n  const handleManualCheckIn = (ticketOrId: string) => {\n    setScannerResult(null);\n    if (!ticketOrId.trim()) return;\n\n    try {\n      const attendee = checkInAttendee(ticketOrId);\n      setScannerResult({\n        success: true,\n        msg: `SUCCESS: Checked in ${attendee.fullName} (${attendee.occupation}) at ${new Date(attendee.checkInTime!).toLocaleTimeString()}`\n      });\n      setScannerInput(\'\');\n      loadData();\n    } catch (e: any) {\n      setScannerResult({\n        success: false,\n        msg: `FAILED: ${e.message || \'Verification Error\'}`\n      });\n    }\n  };\n\n  const handleToggleCheckInTable = (attendee: AttendeeRegistration) => {\n    try {\n      if (attendee.checkedIn) {\n        revertCheckIn(attendee.id);\n      } else {\n        checkInAttendee(attendee.id);\n      }\n      loadData();\n    } catch (e: any) {\n      alert(e.message);\n    }\n  };\n\n  const handleExportCSV = () => {\n    exportToCSV(attendees);\n  };\n\n  const handleResendTicketSimulation = (attendee: AttendeeRegistration, method: \'Email\' | \'WhatsApp\') => {\n    const text = `Simulated ticket re-sending via ${method} to ${attendee.fullName} at ${method === \'Email\' ? attendee.email : attendee.whatsAppNumber}`;\n    alert(`[SYSTEM ACTION] Ticket Pass dispatched!\\nTicket Number: ${attendee.ticketNumber}\\n${text}`);\n  };\n\n  // Filter attendees based on search criteria\n  const filteredAttendees = attendees.filter(a => {\n    const query = searchQuery.toLowerCase();\n    return (\n      a.fullName.toLowerCase().includes(query) ||\n      a.email.toLowerCase().includes(query) ||\n      a.id.toLowerCase().includes(query) ||\n      a.ticketNumber.toLowerCase().includes(query) ||\n      a.district.toLowerCase().includes(query) ||\n      a.occupation.toLowerCase().includes(query)\n    );\n  });\n\n  return (\n    <div id=\"admin-dashboard-root\" className=\"w-full min-h-screen bg-slate-900 text-white font-sans p-6 md:p-12 relative overflow-hidden\">\n      \n      {/* Immersive Dark Cosmic Overlays */}\n      <div className=\"absolute w-[400px] h-[400px] rounded-full bg-purple-500/10 blur-[120px] -top-10 -left-10 pointer-events-none\" />\n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-pink-500/5 blur-[130px] bottom-10 right-10 pointer-events-none\" />\n\n      {/* LOGIN BLOCK */}\n      <AnimatePresence>\n        {!isAuthenticated && (\n          <motion.div \n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-6\"\n          >\n            <motion.div \n              initial={{ scale: 0.95, y: 15 }}\n              animate={{ scale: 1, y: 0 }}\n              className=\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-[32px] p-8 md:p-10 shadow-2xl relative overflow-hidden\"\n            >\n              <div className=\"absolute w-28 h-28 rounded-full bg-purple-500/10 blur-2xl top-0 right-0\" />\n              \n              <div className=\"text-center mb-8 select-none\">\n                <div className=\"w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-400 mx-auto mb-4 border border-purple-500/20\">\n                  <Shield size={20} />\n                </div>\n                <h2 className=\"text-xl font-sans font-bold text-white tracking-tight\">Gatekeeper Portal</h2>\n                <p className=\"text-xs text-slate-400 mt-1.5 font-sans leading-relaxed\">\n                  Provide credentials or volunteer passcode to access registrations, check-in controls, and event analytics.\n                </p>\n                <div className=\"mt-2.5 p-1.5 bg-slate-800/40 border border-slate-800 rounded-lg inline-block text-[10px] font-mono text-purple-300\">\n                  PASSCODE: <span className=\"font-bold underline\">TECHCON2026</span>\n                </div>\n              </div>\n\n              {loginError && (\n                <div className=\"mb-5 p-3 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl text-xs font-medium font-sans\">\n                  {loginError}\n                </div>\n              )}\n\n              <form onSubmit={handleLogin} className=\"space-y-4\">\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[10px] font-mono text-slate-400 tracking-wider uppercase font-semibold\">GATE PASSCODE</label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"password\"\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={password}\n                      onChange={(e) => setPassword(e.target.value)}\n                      className=\"w-full pl-10 pr-4 py-3 bg-slate-950/80 border border-slate-800 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-white\"\n                      autoFocus\n                    />\n                    <Lock size={14} className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500\" />\n                  </div>\n                </div>\n\n                <div className=\"flex gap-2.5 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={onClose}\n                    className=\"flex-1 py-3 border border-slate-800 hover:bg-slate-800 text-slate-300 font-sans font-semibold text-xs rounded-xl transition-all\"\n                  >\n                    RETURN HOME\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"flex-1 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-sans font-semibold text-xs rounded-xl shadow-md transition-all\"\n                  >\n                    UNLOCK ACCESS\n                  </button>\n                </div>\n              </form>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* DASHBOARD SHELL */}\n      {isAuthenticated && stats && (\n        <div className=\"max-w-7xl mx-auto space-y-8 relative z-10\">\n          \n          {/* Header Row */}\n          <div className=\"flex flex-wrap items-center justify-between gap-6 border-b border-slate-800 pb-6\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 shrink-0\">\n                <Shield size={18} />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h1 className=\"text-xl sm:text-2xl font-sans font-bold tracking-tight text-white\">TECHCON \'26 Gate Console</h1>\n                  <span className=\"text-[9px] font-mono bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full border border-purple-500/30\">\n                    {isVolunteerMode ? \'VOLUNTEER MODE\' : \'ADMIN CONSOLE\'}\n                  </span>\n                </div>\n                <p className=\"text-xs text-slate-400 mt-1 font-sans\">\n                  Live verification, check-in triggers, and registration telemetry reports.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <button\n                onClick={loadData}\n                className=\"p-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-slate-300 hover:text-white transition-colors\"\n                title=\"Refresh stats\"\n              >\n                <RefreshCw size={14} className=\"animate-spin\" style={{ animationDuration: \'4s\' }} />\n              </button>\n              \n              <button\n                onClick={() => {\n                  setIsAuthenticated(false);\n                  setPassword(\'\');\n                  setIsVolunteerMode(false);\n                }}\n                className=\"flex items-center gap-2 px-4 py-2 border border-slate-850 hover:bg-red-500/10 hover:border-red-500/20 text-slate-300 hover:text-red-400 font-sans font-semibold text-xs rounded-xl transition-all\"\n              >\n                <LogOut size={13} />\n                <span>Lock Console</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Core Visual Statistics Numbers Cards */}\n          <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n            \n            <div className=\"bg-slate-950/50 border border-slate-850 p-5 rounded-2xl relative overflow-hidden select-none\">\n              <span className=\"text-[9px] font-mono text-slate-400 tracking-wider uppercase block\">TOTAL REGISTRATIONS</span>\n              <span className=\"text-3xl font-mono font-bold text-white mt-1 block tabular-nums\">\n                {stats.totalRegistrations}\n              </span>\n              <div className=\"absolute right-3.5 bottom-3 text-purple-500/20\">\n                <Users size={32} />\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/50 border border-slate-850 p-5 rounded-2xl relative overflow-hidden select-none\">\n              <span className=\"text-[9px] font-mono text-slate-400 tracking-wider uppercase block\">REGISTRATIONS TODAY</span>\n              <span className=\"text-3xl font-mono font-bold text-white mt-1 block tabular-nums\">\n                {stats.todaysRegistrations}\n              </span>\n              <div className=\"absolute right-3.5 bottom-3 text-pink-500/20\">\n                <ClipboardList size={32} />\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/50 border border-slate-850 p-5 rounded-2xl relative overflow-hidden select-none\">\n              <span className=\"text-[9px] font-mono text-slate-400 tracking-wider uppercase block\">ATTENDED CHECK-IN</span>\n              <span className=\"text-3xl font-mono font-bold text-emerald-400 mt-1 block tabular-nums\">\n                {stats.checkedInCount}\n              </span>\n              <div className=\"absolute right-3.5 bottom-3 text-emerald-500/20\">\n                <CheckCircle size={32} />\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/50 border border-slate-850 p-5 rounded-2xl relative overflow-hidden select-none\">\n              <span className=\"text-[9px] font-mono text-slate-400 tracking-wider uppercase block\">ATTENDANCE RATIO</span>\n              <span className=\"text-3xl font-mono font-bold text-blue-400 mt-1 block tabular-nums\">\n                {stats.totalRegistrations > 0 \n                  ? `${Math.round((stats.checkedInCount / stats.totalRegistrations) * 100)}%` \n                  : \'0%\'\n                }\n              </span>\n              <div className=\"absolute right-3.5 bottom-3 text-blue-500/20\">\n                <QrCode size={32} />\n              </div>\n            </div>\n\n          </div>\n\n          {/* Sub Navigation tabs */}\n          <div className=\"flex gap-2.5 border-b border-slate-850 pb-1.5 select-none\">\n            <button\n              onClick={() => setActiveTab(\'analytics\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-sans font-semibold border transition-all ${\n                activeTab === \'analytics\'\n                  ? \'bg-purple-600 border-purple-600 text-white\'\n                  : \'border-transparent text-slate-400 hover:text-white\'\n              }`}\n            >\n              <BarChart3 size={13} />\n              <span>Visual Reports</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'checkin\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-sans font-semibold border transition-all ${\n                activeTab === \'checkin\'\n                  ? \'bg-purple-600 border-purple-600 text-white\'\n                  : \'border-transparent text-slate-400 hover:text-white\'\n              }`}\n            >\n              <QrCode size={13} />\n              <span>Gate Check-In Station</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'directory\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-sans font-semibold border transition-all ${\n                activeTab === \'directory\'\n                  ? \'bg-purple-600 border-purple-600 text-white\'\n                  : \'border-transparent text-slate-400 hover:text-white\'\n              }`}\n            >\n              <ClipboardList size={13} />\n              <span>Attendee Database ({filteredAttendees.length})</span>\n            </button>\n          </div>\n\n          {/* RENDER ACTIVE TAB VIEW */}\n          \n          {/* TAB 1: Visual Reports / SVG Analytics Charts */}\n          {activeTab === \'analytics\' && (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-2\">\n              \n              {/* Chart 1: Role Occupation Ring-style list breakdown */}\n              <div className=\"bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white flex items-center gap-2\">\n                    <PieChart size={16} className=\"text-purple-400\" />\n                    <span>Attendee Category Breakdown</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">Role groups compiled across all registrations</p>\n                </div>\n\n                <div className=\"space-y-4\">\n                  {Object.entries(stats.occupationReport).map(([occupation, count]) => {\n                    const pct = Math.round((count / stats.totalRegistrations) * 100);\n                    return (\n                      <div key={occupation} className=\"space-y-1.5\">\n                        <div className=\"flex items-center justify-between text-xs font-sans\">\n                          <span className=\"font-semibold text-slate-300\">{occupation}</span>\n                          <span className=\"font-mono text-slate-400\">{count} profiles ({pct}%)</span>\n                        </div>\n                        {/* Custom visual progress bar bar */}\n                        <div className=\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n                          <div \n                            className=\"h-full bg-gradient-to-r from-purple-500 to-pink-500 rounded-full\"\n                            style={{ width: `${pct}%` }}\n                          />\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Chart 2: District Distribution Column graph list */}\n              <div className=\"bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white flex items-center gap-2\">\n                    <BarChart3 size={16} className=\"text-pink-400\" />\n                    <span>Regional District Distribution</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">Registrations classified by district of residence</p>\n                </div>\n\n                <div className=\"space-y-4 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar\">\n                  {Object.entries(stats.districtReport).sort((a,b)=>b[1]-a[1]).map(([district, count]) => {\n                    const pct = Math.round((count / stats.totalRegistrations) * 100);\n                    return (\n                      <div key={district} className=\"space-y-1.5\">\n                        <div className=\"flex items-center justify-between text-xs font-sans\">\n                          <span className=\"font-semibold text-slate-300\">{district}</span>\n                          <span className=\"font-mono text-slate-400\">{count} ({pct}%)</span>\n                        </div>\n                        <div className=\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n                          <div \n                            className=\"h-full bg-gradient-to-r from-pink-500 to-blue-500 rounded-full\"\n                            style={{ width: `${pct}%` }}\n                          />\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Chart 3: Technology Interests Breakdown */}\n              <div className=\"bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6 md:col-span-2\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white\">Technology Pipeline Interests</h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">Total tally of specified tech paths</p>\n                </div>\n\n                <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4\">\n                  {Object.entries(stats.interestsReport).sort((a,b)=>b[1]-a[1]).map(([interest, count]) => (\n                    <div key={interest} className=\"bg-slate-900/60 p-3 rounded-xl border border-slate-800/80 flex flex-col justify-between\">\n                      <span className=\"font-mono text-slate-400 text-[10px] uppercase font-bold tracking-wider\">{interest}</span>\n                      <div className=\"flex items-baseline justify-between mt-2.5\">\n                        <span className=\"text-xl font-mono font-extrabold text-white\">{count}</span>\n                        <span className=\"text-[9px] text-slate-500 font-mono\">tallies</span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n            </div>\n          )}\n\n          {/* TAB 2: Gate Check-In Station / QR Terminal Simulation */}\n          {activeTab === \'checkin\' && (\n            <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 pt-2\">\n              \n              {/* Left Side: Gate verification form */}\n              <div className=\"md:col-span-5 bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white flex items-center gap-2\">\n                    <QrCode size={16} className=\"text-purple-400\" />\n                    <span>Check-In Verifier Terminal</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">\n                    Simulate scanning code or type Ticket Serial Number\n                  </p>\n                </div>\n\n                {/* Simulated Camera viewfinder frame */}\n                <div className=\"relative w-full aspect-video bg-slate-950 rounded-2xl border-2 border-dashed border-slate-800 flex flex-col items-center justify-center p-6 overflow-hidden\">\n                  <div className=\"absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-purple-500\" />\n                  <div className=\"absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-purple-500\" />\n                  <div className=\"absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-purple-500\" />\n                  <div className=\"absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-purple-500\" />\n\n                  {/* Horizontal scanning green/red line animation */}\n                  <div className=\"absolute left-0 right-0 h-[1px] bg-emerald-400/80 shadow-[0_0_8px_#34d399] animate-[bounce_2.5s_infinite] pointer-events-none\" />\n\n                  <QrCode size={40} className=\"text-slate-700 animate-pulse\" />\n                  <span className=\"text-[10px] font-mono text-slate-500 tracking-widest mt-3\">GATEWAY LIVE SENSOR</span>\n                </div>\n\n                <div className=\"space-y-4\">\n                  <div className=\"flex flex-col gap-1.5\">\n                    <label className=\"text-[10px] font-mono text-slate-400 tracking-wider\">TICKET ID / SERIAL SERIAL / TOKEN</label>\n                    <div className=\"flex gap-2\">\n                      <input\n                        type=\"text\"\n                        placeholder=\"e.g. TC26-9A1B4C3E\"\n                        value={scannerInput}\n                        onChange={(e) => setScannerInput(e.target.value)}\n                        className=\"flex-1 px-4 py-3 bg-slate-950 border border-slate-800 focus:border-purple-500 rounded-xl outline-none font-mono text-xs uppercase\"\n                        onKeyDown={(e) => e.key === \'Enter\' && handleManualCheckIn(scannerInput)}\n                      />\n                      <button\n                        onClick={() => handleManualCheckIn(scannerInput)}\n                        className=\"px-5 bg-purple-600 hover:bg-purple-500 text-white font-sans font-semibold text-xs rounded-xl shadow-md transition-colors\"\n                      >\n                        CHECK-IN\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Verifier status response card */}\n                  <AnimatePresence>\n                    {scannerResult && (\n                      <motion.div\n                        initial={{ opacity: 0, scale: 0.95 }}\n                        animate={{ opacity: 1, scale: 1 }}\n                        exit={{ opacity: 0 }}\n                        className={`p-4 rounded-xl border flex items-start gap-3 text-xs ${\n                          scannerResult.success\n                            ? \'bg-emerald-500/10 border-emerald-500/20 text-emerald-400\'\n                            : \'bg-red-500/10 border-red-500/20 text-red-400\'\n                        }`}\n                      >\n                        {scannerResult.success ? (\n                          <CheckCircle size={16} className=\"shrink-0 mt-0.5\" />\n                        ) : (\n                          <XCircle size={16} className=\"shrink-0 mt-0.5\" />\n                        )}\n                        <span className=\"font-mono\">{scannerResult.msg}</span>\n                      </motion.div>\n                    )}\n                  </AnimatePresence>\n                </div>\n              </div>\n\n              {/* Right Side: Quick click search and gate verification check-ins list */}\n              <div className=\"md:col-span-7 bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white\">Direct Verification Board</h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">Click on any attendee card below to instantly mark check-in</p>\n                </div>\n\n                <div className=\"relative\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Search attendee by name, serial or district...\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    className=\"w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-sans\"\n                  />\n                  <Search size={14} className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500\" />\n                </div>\n\n                <div className=\"space-y-2.5 max-h-[320px] overflow-y-auto pr-2 custom-scrollbar\">\n                  {filteredAttendees.map((attendee) => (\n                    <div \n                      key={attendee.id}\n                      className={`p-3.5 bg-slate-900 border rounded-xl flex items-center justify-between gap-4 transition-all duration-300 ${\n                        attendee.checkedIn \n                          ? \'border-emerald-500/20 bg-emerald-500/5\' \n                          : \'border-slate-800 hover:border-slate-700\'\n                      }`}\n                    >\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-semibold text-xs text-white truncate uppercase\">{attendee.fullName}</span>\n                          <span className=\"font-mono text-[9px] bg-slate-800 px-2 py-0.5 rounded text-slate-400\">\n                            {attendee.id}\n                          </span>\n                        </div>\n                        <div className=\"flex flex-wrap items-center gap-x-2 text-[10px] text-slate-400 mt-1\">\n                          <span className=\"font-mono\">{attendee.ticketNumber}</span>\n                          <span>\342\200\242</span>\n                          <span>{attendee.occupation}</span>\n                          <span>\342\200\242</span>\n                          <span>{attendee.district}</span>\n                        </div>\n                      </div>\n\n                      {/* Gate check action toggle button */}\n                      <button\n                        onClick={() => handleToggleCheckInTable(attendee)}\n                        className={`px-3 py-1.5 rounded-lg text-[10px] font-mono tracking-wider font-semibold transition-colors ${\n                          attendee.checkedIn\n                            ? \'bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30\'\n                            : \'bg-purple-600 hover:bg-purple-500 text-white\'\n                        }`}\n                      >\n                        {attendee.checkedIn ? \'CHECKED-IN\' : \'CHECK-IN\'}\n                      </button>\n                    </div>\n                  ))}\n                  {filteredAttendees.length === 0 && (\n                    <div className=\"text-center py-10 text-xs text-slate-500 font-mono\">\n                      NO MATCHING RECORD FOUND\n                    </div>\n                  )}\n                </div>\n              </div>\n\n            </div>\n          )}\n\n          {/* TAB 3: Attendee Directory Grid / Export Actions */}\n          {activeTab === \'directory\' && (\n            <div className=\"bg-slate-950/40 border border-slate-850 p-6 sm:p-8 rounded-3xl space-y-6\">\n              \n              <div className=\"flex flex-wrap items-center justify-between gap-4\">\n                <div>\n                  <h3 className=\"text-base font-sans font-bold text-white\">Registered Attendee Database</h3>\n                  <p className=\"text-xs text-slate-400 mt-1 font-sans\">\n                    Complete listing of {filteredAttendees.length} records.\n                  </p>\n                </div>\n\n                {/* Exporter actions block (Hidden in volunteer mode) */}\n                {!isVolunteerMode && (\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={handleExportCSV}\n                      className=\"flex items-center gap-1.5 px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-sans font-semibold text-white transition-colors\"\n                    >\n                      <Download size={13} />\n                      <span>Export CSV Report</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Data Search filter */}\n              <div className=\"relative\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Filter directory by Passenger Name, Ticket ID, Sector, or District...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-sans\"\n                />\n                <Search size={14} className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500\" />\n              </div>\n\n              {/* Big Data Table (Responsive block-list cards on mobile, grid list on tablet) */}\n              <div className=\"overflow-x-auto border border-slate-800 rounded-2xl max-h-[350px] overflow-y-auto custom-scrollbar\">\n                <table className=\"w-full border-collapse text-left text-xs text-slate-300 select-none\">\n                  <thead>\n                    <tr className=\"bg-slate-950 text-[10px] font-mono text-slate-400 tracking-wider border-b border-slate-800\">\n                      <th className=\"p-4 uppercase\">PASSENGER NAME</th>\n                      <th className=\"p-4 uppercase\">PASS SERIAL</th>\n                      <th className=\"p-4 uppercase\">SECTOR GROUP</th>\n                      <th className=\"p-4 uppercase\">DISTRICT</th>\n                      <th className=\"p-4 uppercase text-center\">CHECK-IN STATUS</th>\n                      {!isVolunteerMode && <th className=\"p-4 uppercase text-center\">ACTIONS</th>}\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-850\">\n                    {filteredAttendees.map((a) => (\n                      <tr key={a.id} className=\"hover:bg-slate-900/60 transition-colors\">\n                        <td className=\"p-4 font-semibold text-white\">\n                          <div className=\"flex flex-col\">\n                            <span>{a.fullName}</span>\n                            <span className=\"text-[10px] text-slate-400 font-mono font-normal mt-0.5\">{a.email}</span>\n                          </div>\n                        </td>\n                        <td className=\"p-4 font-mono font-bold text-purple-300\">\n                          {a.ticketNumber}\n                        </td>\n                        <td className=\"p-4\">\n                          {a.occupation}\n                        </td>\n                        <td className=\"p-4\">\n                          {a.district}\n                        </td>\n                        <td className=\"p-4 text-center\">\n                          {a.checkedIn ? (\n                            <span className=\"inline-flex items-center gap-1 bg-emerald-500/15 border border-emerald-500/20 text-emerald-400 px-2.5 py-1 rounded-full text-[10px] font-mono\">\n                              <CheckCircle size={10} />\n                              <span>{a.checkInTime ? new Date(a.checkInTime).toLocaleTimeString() : \'YES\'}</span>\n                            </span>\n                          ) : (\n                            <span className=\"inline-flex items-center gap-1 bg-slate-800 border border-slate-700 text-slate-400 px-2.5 py-1 rounded-full text-[10px] font-mono\">\n                              <XCircle size={10} />\n                              <span>PENDING</span>\n                            </span>\n                          )}\n                        </td>\n                        {!isVolunteerMode && (\n                          <td className=\"p-4 text-center\">\n                            <div className=\"flex items-center justify-center gap-1.5\">\n                              {/* Resend via Email */}\n                              <button\n                                onClick={() => handleResendTicketSimulation(a, \'Email\')}\n                                className=\"p-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-400 hover:text-white\"\n                                title=\"Resend Ticket via Email\"\n                              >\n                                <Send size={12} />\n                              </button>\n                              \n                              {/* Toggle Check in */}\n                              <button\n                                onClick={() => handleToggleCheckInTable(a)}\n                                className={`px-2.5 py-1 border rounded text-[10px] font-semibold ${\n                                  a.checkedIn \n                                    ? \'bg-red-500/10 border-red-500/20 text-red-400 hover:bg-red-500/20\' \n                                    : \'bg-emerald-500/10 border-emerald-500/20 text-emerald-400 hover:bg-emerald-500/20\'\n                                }`}\n                              >\n                                {a.checkedIn ? \'Revert\' : \'Force Check-in\'}\n                              </button>\n                            </div>\n                          </td>\n                        )}\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n\n            </div>\n          )}\n\n          {/* Return Home footer trigger */}\n          <div className=\"text-center select-none\">\n            <button\n              onClick={onClose}\n              className=\"py-3 px-8 border border-slate-800 hover:bg-slate-800 text-slate-400 hover:text-white font-sans font-semibold text-xs rounded-full transition-colors inline-flex items-center gap-2\"\n            >\n              <span>RETURN TO MAIN SITE</span>\n            </button>\n          </div>\n\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
