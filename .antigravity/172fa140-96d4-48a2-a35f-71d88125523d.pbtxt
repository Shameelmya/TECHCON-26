    instruction: "Update Hero.tsx headings and copy to look futuristic, premium, and fully aligned with the TECHCON logo brand kit and color scheme."
    replacement_infos {
      original_chunk {
        target_content: "        {/* Left column: Headings and copy */}\n        <div className=\"lg:col-span-7 flex flex-col justify-center text-left order-2 lg:order-1\">\n          {/* Tagline / Organizer */}\n          <motion.div \n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6 }}\n            className=\"inline-flex items-center gap-2 px-3 py-1 bg-slate-50 border border-slate-100 rounded-full w-fit mb-6\"\n          >\n            <span className=\"w-1.5 h-1.5 rounded-full bg-purple-600 animate-ping\" />\n            <span className=\"text-[11px] font-mono tracking-widest text-slate-500 uppercase\">\n              msf TechFed <span className=\"text-slate-300\">|</span> Defining the Future\n            </span>\n          </motion.div>\n\n          {/* Premium Huge Typography */}\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1 }}\n            className=\"flex flex-col mb-6\"\n          >\n            <h1 className=\"text-5xl sm:text-7xl xl:text-8xl font-sans tracking-tight font-extrabold text-slate-900 leading-[0.95]\">\n              <span className=\"block text-transparent bg-clip-text bg-gradient-to-r from-slate-950 via-slate-900 to-slate-800\">DEFINING</span>\n              <span className=\"block text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-slate-950\">THE</span>\n              <span className=\"block text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-pink-500 to-blue-600\">FUTURE</span>\n            </h1>\n          </motion.div>\n\n          {/* Brief introduction paragraph */}\n          <motion.p\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6, delay: 0.2 }}\n            className=\"text-[15px] sm:text-[17px] text-slate-500 font-sans font-normal leading-relaxed mb-8 max-w-xl\"\n          >\n            The future of technology, innovation, and collaboration begins at TECHCON \'26. \n            Join developers, scholars, and tech leaders for India\'s premium conference.\n          </motion.p>\n\n          {/* Key Metadata Row */}\n          <motion.div \n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6, delay: 0.3 }}\n            className=\"grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-slate-100 pt-6 mb-8 max-w-lg\"\n          >\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-full bg-purple-50 flex items-center justify-center text-purple-600 shrink-0\">\n                <Calendar size={14} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[10px] font-mono tracking-widest text-slate-400 uppercase\">DATE</span>\n                <span className=\"text-xs font-sans font-semibold text-slate-800\">15 July 2026</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-full bg-pink-50 flex items-center justify-center text-pink-600 shrink-0\">\n                <MapPin size={14} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[10px] font-mono tracking-widest text-slate-400 uppercase\">VENUE</span>\n                <span className=\"text-xs font-sans font-semibold text-slate-800\">CUSAT, Kochi</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2.5 col-span-2 sm:col-span-1\">\n              <div className=\"w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 shrink-0\">\n                <User size={14} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[10px] font-mono tracking-widest text-slate-400 uppercase\">ORGANIZER</span>\n                <span className=\"text-xs font-sans font-semibold text-slate-800\">msf TechFed</span>\n              </div>\n            </div>\n          </motion.div>"
        replacement_content: "        {/* Left column: Headings and copy */}\n        <div className=\"lg:col-span-7 flex flex-col justify-center text-left order-2 lg:order-1\">\n          {/* Tagline / Organizer */}\n          <motion.div \n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6 }}\n            className=\"inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-slate-950 text-slate-100 border border-slate-800 rounded-full w-fit mb-6 shadow-sm\"\n          >\n            <span className=\"w-1.5 h-1.5 rounded-full bg-brand-pink animate-ping\" />\n            <span className=\"text-[10px] font-mono tracking-[0.2em] uppercase flex items-center gap-1\">\n              <span className=\"text-brand-blue font-bold\">msf TechFed</span>\n              <span className=\"text-slate-600\">|</span>\n              <span className=\"text-slate-400\">Official Assembly</span>\n            </span>\n          </motion.div>\n\n          {/* Premium High-Tech Brand Identity Typography */}\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1 }}\n            className=\"flex flex-col mb-6\"\n          >\n            <div className=\"flex items-baseline gap-2 flex-wrap\">\n              <h1 className=\"text-6xl sm:text-8xl font-orbitron font-extrabold tracking-[0.06em] leading-none text-slate-950 uppercase\">\n                techcon\n              </h1>\n              <span className=\"font-orbitron font-black text-5xl sm:text-7xl text-brand-pink tracking-tight leading-none\">\n                26\n              </span>\n            </div>\n            \n            {/* Slogan with high letter spacing from the logo concept */}\n            <div className=\"mt-3.5 flex items-center gap-3\">\n              <span className=\"h-[1px] w-8 bg-gradient-to-r from-brand-pink to-brand-purple\" />\n              <span className=\"text-xs sm:text-sm font-display font-medium tracking-[0.45em] text-transparent bg-clip-text bg-gradient-to-r from-brand-pink via-brand-purple to-brand-blue uppercase\">\n                defining the future\n              </span>\n            </div>\n          </motion.div>\n\n          {/* Brief introduction paragraph */}\n          <motion.p\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6, delay: 0.2 }}\n            className=\"text-[14px] sm:text-[16px] text-slate-500 font-sans font-normal leading-relaxed mb-8 max-w-xl\"\n          >\n            The premium technological assembly of India begins here. Join developers, researchers, and network architects at the historic CUSAT campus in Kochi to co-create tomorrow\'s digital infrastructure.\n          </motion.p>\n\n          {/* Key Metadata Row */}\n          <motion.div \n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6, delay: 0.3 }}\n            className=\"grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-slate-100 pt-6 mb-8 max-w-lg\"\n          >\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-9 h-9 rounded-xl bg-purple-50 flex items-center justify-center text-brand-purple shrink-0 border border-purple-100/50\">\n                <Calendar size={15} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[9px] font-mono tracking-widest text-slate-400 uppercase\">DATE</span>\n                <span className=\"text-xs font-sans font-bold text-slate-800\">15 July 2026</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-9 h-9 rounded-xl bg-pink-50 flex items-center justify-center text-brand-pink shrink-0 border border-pink-100/50\">\n                <MapPin size={15} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[9px] font-mono tracking-widest text-slate-400 uppercase\">VENUE</span>\n                <span className=\"text-xs font-sans font-bold text-slate-800\">CUSAT, Kochi</span>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2.5 col-span-2 sm:col-span-1\">\n              <div className=\"w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center text-brand-blue shrink-0 border border-blue-100/50\">\n                <User size={15} />\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[9px] font-mono tracking-widest text-slate-400 uppercase\">ORGANIZER</span>\n                <span className=\"text-xs font-sans font-bold text-slate-800\">msf TechFed</span>\n              </div>\n            </div>\n          </motion.div>"
