      replacement_content: "      {/* 1. Futuristic Intro Loader */}\n      <AnimatePresence mode=\"wait\">\n        {isLoading && (\n          <motion.div key=\"preloader\" className=\"fixed inset-0 z-50\">\n            <Loader onComplete={() => setIsLoading(false)} />\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {!isLoading && (\n        <div className=\"relative min-h-screen bg-white text-slate-900 overflow-x-hidden selection:bg-purple-600 selection:text-white\">\n          \n          {/* Subtle canvas circuit backgrounds & cursor */}\n          <CircuitBackground />\n          <CustomCursor />\n\n          {/* 2. Glassmorphic Sticky Navigation */}\n          <Navbar \n            onNavigate={(id) => {\n              const element = document.getElementById(id);\n              if (element) {\n                element.scrollIntoView({ behavior: \'smooth\' });\n              }\n            }}\n            activeSection=\"hero\"\n            onOpenRegister={() => setIsRegisterOpen(true)}\n            onOpenAdmin={() => setIsAdminOpen(true)}\n          />\n\n          {/* 3. Render Pass Card if passenger successfully registered */}\n          {activeRegistration ? (\n            <div className=\"pt-24 min-h-[90vh] flex items-center justify-center\">\n              <TicketPass \n                registration={activeRegistration} \n                onBackToHome={handleBackToHomeFromPass} \n              />\n            </div>\n          ) : (\n            /* Main Interactive Website Landings */\n            <main className=\"relative\">\n              \n              {/* Hero fold */}\n              <Hero \n                onOpenRegister={() => setIsRegisterOpen(true)} \n                onExploreEvent={() => {\n                  const element = document.getElementById(\'about\');\n                  if (element) {\n                    element.scrollIntoView({ behavior: \'smooth\' });\n                  }\n                }}\n              />"
