    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport { \n  MapPin, Navigation, Train, Plane, Compass, \n  Map, Info, Users, Cpu, Code\n} from \'lucide-react\';\n\nexport default function Venue() {\n  const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=Cochin+University+of+Science+and+Technology,+Kochi,+Kerala,+India`;\n\n  return (\n    <section \n      id=\"venue\" \n      className=\"py-20 sm:py-28 bg-brand-dark border-t border-slate-900 px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Background grids & radial glow blobs */}\n      <div \n        className=\"absolute inset-0 pointer-events-none opacity-[0.02]\" \n        style={{\n          backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n          backgroundSize: \'30px 30px\'\n        }}\n      />\n      \n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-brand-pink/10 to-brand-purple/10 blur-[130px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        \n        {/* Header Title with futuristic layout */}\n        <div className=\"text-center max-w-2xl mx-auto mb-16\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-brand-pink/10 border border-brand-pink/20 rounded-full mb-4\">\n            <Map size={12} className=\"text-brand-pink animate-pulse\" />\n            <span className=\"text-[10px] font-mono tracking-[0.2em] text-brand-pink uppercase font-bold\">\n              TRANSIT & DESTINATION\n            </span>\n          </div>\n          \n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-orbitron font-bold tracking-[0.06em] text-white mb-5 uppercase\">\n            The Venue: CUSAT, <span className=\"text-brand-pink font-extrabold font-orbitron\">Kochi</span>\n          </h2>\n          \n          <p className=\"text-xs sm:text-sm font-sans text-slate-400 leading-relaxed max-w-xl mx-auto\">\n            The assembly is hosted at Cochin University of Science and Technology, Kalamassery. CUSAT stands as Kerala\'s premier technological and academic campus.\n          </p>\n        </div>\n\n        {/* Column layout: Transit Info Guide & Collaboration Grounds */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Left Column: Dark Transit Info Details Card */}\n          <div className=\"lg:col-span-6 flex flex-col justify-between bg-brand-navy/50 backdrop-blur-md border border-slate-800/80 p-6 sm:p-8 rounded-[32px] shadow-2xl relative overflow-hidden\">\n            <div className=\"absolute left-0 top-0 p-3 select-none pointer-events-none opacity-20\">\n              <span className=\"font-mono text-[9px] text-slate-400\">LOC.A_TRANSIT_GRID_026</span>\n            </div>\n\n            <div className=\"relative z-10 space-y-6\">\n              <div>\n                <span className=\"text-[10px] font-mono tracking-[0.2em] text-brand-pink uppercase font-bold block mb-2\">// QUICK TRANSIT COMMANDS</span>\n                <h3 className=\"text-xl sm:text-2xl font-orbitron font-bold text-white uppercase tracking-wide\">Transit & Location Nodes</h3>\n                <p className=\"text-xs sm:text-sm text-slate-400 font-sans leading-relaxed mt-2\">\n                  CUSAT campus is centrally linked with excellent transit lines, allowing hassle-free arrivals from all major districts of Kerala.\n                </p>\n              </div>\n\n              {/* Transit Details Bars */}\n              <div className=\"space-y-4\">\n                {/* Metro Node */}\n                <div className=\"flex items-start gap-4 p-4 bg-slate-950/45 rounded-2xl border border-slate-800/60 hover:border-slate-700/60 transition-colors\">\n                  <div className=\"w-9 h-9 rounded-xl bg-brand-purple/20 border border-brand-purple/30 flex items-center justify-center shrink-0 text-brand-purple\">\n                    <Train size={16} />\n                  </div>\n                  <div className=\"space-y-0.5\">\n                    <h4 className=\"text-xs font-mono font-bold text-brand-purple uppercase tracking-wider\">Nearest Metro Station</h4>\n                    <p className=\"text-sm font-orbitron font-bold text-slate-100 uppercase tracking-wide\">CUSAT Metro Station <span className=\"text-slate-500 font-sans text-xs\">(250m)</span></p>\n                    <p className=\"text-xs text-slate-400 font-sans leading-normal\">Located directly at the campus entrance. High-frequency shuttles and e-autos run to the auditorium.</p>\n                  </div>\n                </div>\n\n                {/* Railway Node */}\n                <div className=\"flex items-start gap-4 p-4 bg-slate-950/45 rounded-2xl border border-slate-800/60 hover:border-slate-700/60 transition-colors\">\n                  <div className=\"w-9 h-9 rounded-xl bg-brand-pink/20 border border-brand-pink/30 flex items-center justify-center shrink-0 text-brand-pink\">\n                    <Compass size={16} />\n                  </div>\n                  <div className=\"space-y-0.5\">\n                    <h4 className=\"text-xs font-mono font-bold text-brand-pink uppercase tracking-wider\">Nearest Railway Station</h4>\n                    <p className=\"text-sm font-orbitron font-bold text-slate-100 uppercase tracking-wide\">Ernakulam Town ERN / Aluva AWY <span className=\"text-slate-500 font-sans text-xs\">(9km - 11km)</span></p>\n                    <p className=\"text-xs text-slate-400 font-sans leading-normal\">Both hubs link directly with the Kochi Metro network for immediate, fast transit to the campus entrance.</p>\n                  </div>\n                </div>\n\n                {/* Airport Node */}\n                <div className=\"flex items-start gap-4 p-4 bg-slate-950/45 rounded-2xl border border-slate-800/60 hover:border-slate-700/60 transition-colors\">\n                  <div className=\"w-9 h-9 rounded-xl bg-brand-blue/20 border border-brand-blue/30 flex items-center justify-center shrink-0 text-brand-blue\">\n                    <Plane size={16} />\n                  </div>\n                  <div className=\"space-y-0.5\">\n                    <h4 className=\"text-xs font-mono font-bold text-brand-blue uppercase tracking-wider\">Nearest Airport</h4>\n                    <p className=\"text-sm font-orbitron font-bold text-slate-100 uppercase tracking-wide\">Cochin International Airport COK <span className=\"text-slate-500 font-sans text-xs\">(22km)</span></p>\n                    <p className=\"text-xs text-slate-400 font-sans leading-normal\">Nedumbassery Airport has standard prepaid airport cabs, Uber services, and direct shuttle buses to Kalamassery.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Actions */}\n            <div className=\"border-t border-slate-900 pt-6 mt-8 flex flex-wrap items-center justify-between gap-4 relative z-10\">\n              <span className=\"text-[10px] font-mono text-slate-500 uppercase\">Kochi, Kerala, India</span>\n              <a\n                href={directionsUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-pink text-white font-sans font-bold text-xs rounded-full transition-all duration-300 hover:shadow-[0_4px_16px_rgba(120,45,255,0.3)] hover:-translate-y-0.5\"\n              >\n                <Navigation size={13} className=\"animate-pulse\" />\n                <span>GET DIRECTIONS</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Right Column: Collaboration Grounds (Instead of Schematic scheduling) */}\n          <div className=\"lg:col-span-6 bg-[#0c101b] rounded-[32px] p-6 sm:p-8 flex flex-col justify-between text-white relative overflow-hidden shadow-2xl border border-slate-800/80\">\n            {/* Soft backdrop glow */}\n            <div className=\"absolute w-72 h-72 rounded-full bg-brand-purple/10 blur-[80px] -top-20 -right-20 pointer-events-none\" />\n\n            {/* Header */}\n            <div className=\"relative z-10 mb-6 flex items-center justify-between\">\n              <div>\n                <span className=\"text-[10px] font-mono tracking-widest text-brand-purple uppercase font-bold\">EXHIBITS & ZONES</span>\n                <h4 className=\"text-lg font-orbitron font-bold text-white mt-0.5 uppercase tracking-[0.05em]\">Collaboration Grounds</h4>\n              </div>\n              <span className=\"text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 bg-emerald-500/15 border border-emerald-500/35 px-3 py-1 rounded-full\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n                <span>MEETUP ZONES MAP</span>\n              </span>\n            </div>\n\n            {/* Interactive Vector Overlay for Collaboration Grounds */}\n            <div className=\"relative w-full h-56 sm:h-64 bg-slate-950/80 rounded-2xl border border-slate-800/80 p-5 overflow-hidden flex flex-col justify-between shadow-inner select-none\">\n              \n              {/* Grid Background */}\n              <div \n                className=\"absolute inset-0 opacity-[0.03] pointer-events-none\"\n                style={{\n                  backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n                  backgroundSize: \'16px 16px\'\n                }}\n              />\n\n              {/* Schematic Map Layout of Collaboration Grounds */}\n              <div className=\"grid grid-cols-2 gap-4 h-full relative z-10\">\n                {/* Zone 1 */}\n                <div className=\"p-3 bg-brand-navy/60 border border-slate-800 rounded-xl flex flex-col justify-between hover:border-slate-700 transition-colors\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-[9px] font-mono text-slate-500\">// ZONE ALPHA</span>\n                    <Cpu size={14} className=\"text-brand-pink\" />\n                  </div>\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-100 uppercase\">AI & Hardware Bay</h5>\n                    <p className=\"text-[10px] font-sans text-slate-400 mt-1\">Smart village demos and telemetry assemblies.</p>\n                  </div>\n                </div>\n\n                {/* Zone 2 */}\n                <div className=\"p-3 bg-brand-navy/60 border border-slate-800 rounded-xl flex flex-col justify-between hover:border-slate-700 transition-colors\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-[9px] font-mono text-slate-500\">// ZONE BETA</span>\n                    <Code size={14} className=\"text-brand-purple\" />\n                  </div>\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-100 uppercase\">Hacker Lounge</h5>\n                    <p className=\"text-[10px] font-sans text-slate-400 mt-1\">Workshops, student code challenges, and peer networking.</p>\n                  </div>\n                </div>\n\n                {/* Zone 3 */}\n                <div className=\"p-3 bg-brand-navy/60 border border-slate-800 rounded-xl flex flex-col justify-between hover:border-slate-700 transition-colors\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-[9px] font-mono text-slate-500\">// ZONE GAMMA</span>\n                    <Users size={14} className=\"text-brand-blue\" />\n                  </div>\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-100 uppercase\">msf Tech Wing Desk</h5>\n                    <p className=\"text-[10px] font-sans text-slate-400 mt-1\">Kerala State Committee registration & career hubs.</p>\n                  </div>\n                </div>\n\n                {/* Zone 4 */}\n                <div className=\"p-3 bg-brand-navy/60 border border-slate-800 rounded-xl flex flex-col justify-between hover:border-slate-700 transition-colors\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-[9px] font-mono text-slate-500\">// ZONE DELTA</span>\n                    <Info size={14} className=\"text-emerald-400\" />\n                  </div>\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-100 uppercase\">Exhibition & Games</h5>\n                    <p className=\"text-[10px] font-sans text-slate-400 mt-1\">Interactive student tech booths and challenge stages.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Coordinates / Footer info */}\n            <div className=\"relative z-10 border-t border-slate-900 pt-5 mt-6 flex flex-wrap items-center justify-between gap-3 text-xs\">\n              <div className=\"flex items-center gap-2 bg-slate-950/60 border border-slate-900 px-3 py-1.5 rounded-xl\">\n                <Compass size={14} className=\"text-brand-purple animate-spin\" style={{ animationDuration: \'8s\' }} />\n                <span className=\"font-mono text-slate-400\">GPS Node: CUSAT Kalamassery, Kochi</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}"
    }
