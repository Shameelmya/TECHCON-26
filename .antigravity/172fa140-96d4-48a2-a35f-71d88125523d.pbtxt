  file_change {
    absolute_path_uri: "file:///src/components/Venue.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { MapPin, Navigation, Train, Plane, Compass, Hotel } from \'lucide-react\';\n\nexport default function Venue() {\n  const [activeTab, setActiveTab] = useState<\'metro\' | \'airport\' | \'railway\' | \'stay\'>(\'metro\');\n\n  const CUSAT_LAT_LNG = \"9.9447,76.2244\"; // CUSAT campus, Kochi, India\n  const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=Cochin+University+of+Science+and+Technology,+Kochi,+Kerala,+India`;\n\n  const tabsInfo = {\n    metro: {\n      icon: <Train className=\"text-purple-600\" size={18} />,\n      title: \'Kochi Metro Transit\',\n      headline: \'CUSAT Metro Station (Line 1)\',\n      desc: \'The Kochi Metro is the fastest and cleanest transit method. Alight at \"CUSAT Metro Station\", which is located directly at the main entrance gate of the campus. From there, electric autos and shuttles can transport you to the venue auditorium (approx 3 minutes).\',\n      time: \'Frequency: Every 7 minutes\'\n    },\n    airport: {\n      icon: <Plane className=\"text-pink-600\" size={18} />,\n      title: \'Air Travel Connection\',\n      headline: \'Cochin International Airport (COK)\',\n      desc: \'Located at Nedumbassery, COK airport is approximately 22 kilometers (40 minutes drive) from the CUSAT campus. Registered pre-paid airport cabs, Uber, and airport city-buses are readily available at the arrival terminal.\',\n      time: \'Transit cost: \342\202\271450 - \342\202\271700\'\n    },\n    railway: {\n      icon: <Compass className=\"text-blue-600\" size={18} />,\n      title: \'Railway Connections\',\n      headline: \'Ernakulam Town (ERN) or Aluva (AWY)\',\n      desc: \'The nearest major railway hubs are Ernakulam Town (North) and Aluva station. ERN is 11 km south of CUSAT, and Aluva is 9 km north. Both stations are directly connected to the Kochi Metro network for instant transit to the campus.\',\n      time: \'Metro travel time: ~15 mins\'\n    },\n    stay: {\n      icon: <Hotel className=\"text-indigo-600\" size={18} />,\n      title: \'Accommodations & Hotels\',\n      headline: \'Premium partner stays near Kalamassery\',\n      desc: \'msf TechFed has secured discounted rooms at premium hotels near CUSAT Kalamassery (including Marriott Kochi, Port Muziris, and local boutique executive suites). Contact the organizing hospitality desk with your Registration ID to lock booking rates.\',\n      time: \'Rooms starting from \342\202\2711,800/night\'\n    }\n  };\n\n  return (\n    <section \n      id=\"venue\" \n      className=\"py-24 sm:py-32 bg-slate-50/50 px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Background radial gradient */}\n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-purple-100/30 to-pink-100/20 blur-[120px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        \n        {/* Header Title */}\n        <div className=\"text-center max-w-xl mx-auto mb-20\">\n          <span className=\"text-xs font-mono font-semibold tracking-widest text-purple-600 uppercase block mb-3\">\n            EVENT LOCATION & TRANSIT\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-sans font-bold tracking-tight text-slate-900 mb-5\">\n            The Venue: CUSAT, Kochi\n          </h2>\n          <p className=\"text-sm font-sans text-slate-500 leading-relaxed\">\n            The conference is hosted at Cochin University of Science and Technology, Kalamassery. \n            CUSAT stands as a historical emblem of technology and academic marvel in Kerala, India.\n          </p>\n        </div>\n\n        {/* Column layout: Map & Guide Details */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Left Column: Interactive Tabbed Transit Guide */}\n          <div className=\"lg:col-span-6 flex flex-col justify-between bg-white border border-slate-100 p-8 rounded-[32px] shadow-sm\">\n            <div>\n              {/* Tabs list */}\n              <div className=\"flex flex-wrap gap-2 mb-8 bg-slate-50 p-1.5 rounded-2xl border border-slate-100 w-fit\">\n                {(Object.keys(tabsInfo) as Array<keyof typeof tabsInfo>).map((key) => (\n                  <button\n                    key={key}\n                    onClick={() => setActiveTab(key)}\n                    className={`flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-sans font-medium transition-all duration-300 ${\n                      activeTab === key\n                        ? \'bg-white text-slate-950 shadow-[0_2px_8px_rgba(0,0,0,0.04)] border border-slate-100\'\n                        : \'text-slate-500 hover:text-slate-900 hover:bg-white/30\'\n                    }`}\n                  >\n                    {tabsInfo[key].icon}\n                    <span className=\"capitalize\">{key}</span>\n                  </button>\n                ))}\n              </div>\n\n              {/* Tab Display Area */}\n              <motion.div\n                key={activeTab}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.3 }}\n                className=\"space-y-4\"\n              >\n                <div className=\"flex items-center gap-2 text-xs font-mono text-slate-400\">\n                  <MapPin size={13} className=\"text-purple-500\" />\n                  <span>{tabsInfo[activeTab].title}</span>\n                </div>\n                <h3 className=\"text-xl sm:text-2xl font-sans font-bold text-slate-900 leading-tight\">\n                  {tabsInfo[activeTab].headline}\n                </h3>\n                <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 leading-relaxed\">\n                  {tabsInfo[activeTab].desc}\n                </p>\n              </motion.div>\n            </div>\n\n            {/* Bottom Actions */}\n            <div className=\"border-t border-slate-100 pt-6 mt-8 flex flex-wrap items-center justify-between gap-4\">\n              <span className=\"text-xs font-mono text-purple-600 font-semibold bg-purple-50 px-3 py-1 rounded-full\">\n                {tabsInfo[activeTab].time}\n              </span>\n\n              <a\n                href={directionsUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-slate-950 hover:bg-purple-600 text-white font-sans font-semibold text-xs rounded-full transition-all duration-300 shadow-md\"\n              >\n                <Navigation size={13} />\n                <span>GET DIRECTIONS</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Right Column: Stylized Vector Interactive Transit Map */}\n          <div className=\"lg:col-span-6 bg-slate-900 rounded-[32px] p-6 sm:p-8 flex flex-col justify-between text-white relative overflow-hidden shadow-xl border border-slate-800\">\n            {/* Soft backdrop glow */}\n            <div className=\"absolute w-72 h-72 rounded-full bg-purple-500/10 blur-[80px] -top-20 -right-20 pointer-events-none\" />\n\n            {/* Map Header */}\n            <div className=\"relative z-10 mb-6 flex items-center justify-between\">\n              <div>\n                <span className=\"text-[10px] font-mono tracking-widest text-purple-400 uppercase\">CAMPUS VECTOR SCHEMATIC</span>\n                <h4 className=\"text-base font-sans font-bold text-white mt-1\">CUSAT Kalamassery Campus</h4>\n              </div>\n              <span className=\"text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 bg-emerald-500/10 px-2 py-0.5 rounded-full\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n                <span>ONLINE MAP</span>\n              </span>\n            </div>\n\n            {/* Stylized Vector Map Graphics */}\n            <div className=\"relative w-full h-48 sm:h-64 bg-slate-950/60 rounded-2xl border border-slate-800/80 p-4 overflow-hidden flex items-center justify-center select-none\">\n              \n              {/* Circuit Grid Background */}\n              <div \n                className=\"absolute inset-0 opacity-[0.03] pointer-events-none\"\n                style={{\n                  backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n                  backgroundSize: \'16px 16px\'\n                }}\n              />\n\n              {/* Styled Road Tracks & Connections */}\n              <svg viewBox=\"0 0 400 200\" className=\"w-full h-full text-slate-800\">\n                {/* Major Highway (NH 544) */}\n                <path d=\"M 10,20 L 390,20\" fill=\"none\" stroke=\"#1e293b\" strokeWidth=\"6\" strokeLinecap=\"round\" />\n                <path d=\"M 10,20 L 390,20\" fill=\"none\" stroke=\"#2a3342\" strokeWidth=\"1\" strokeDasharray=\"4,4\" />\n                \n                {/* CUSAT Road Branch */}\n                <path d=\"M 200,20 L 200,180\" fill=\"none\" stroke=\"#1e293b\" strokeWidth=\"4\" strokeLinecap=\"round\" />\n                <path d=\"M 200,80 L 100,110 L 100,160\" fill=\"none\" stroke=\"#1e293b\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n                <path d=\"M 200,130 L 300,140\" fill=\"none\" stroke=\"#1e293b\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n\n                {/* Metro Track line */}\n                <path d=\"M 10,12 L 390,12\" fill=\"none\" stroke=\"#782DFF\" strokeWidth=\"2\" strokeOpacity=\"0.4\" />\n                \n                {/* Map Nodes */}\n                {/* Metro Station */}\n                <g className=\"cursor-pointer\">\n                  <circle cx=\"200\" cy=\"20\" r=\"6\" fill=\"#782DFF\" />\n                  <circle cx=\"200\" cy=\"20\" r=\"10\" fill=\"#782DFF\" fillOpacity=\"0.2\" className=\"animate-ping\" />\n                </g>\n\n                {/* CUSAT Main Campus Gate */}\n                <circle cx=\"200\" cy=\"60\" r=\"4\" fill=\"#64748b\" />\n\n                {/* Main Venue Hall (Auditorium) */}\n                <g className=\"cursor-pointer\">\n                  <rect x=\"80\" y=\"150\" width=\"40\" height=\"20\" rx=\"3\" fill=\"#FF20BE\" />\n                  <circle cx=\"100\" cy=\"160\" r=\"2.5\" fill=\"#ffffff\" />\n                  <circle cx=\"100\" cy=\"160\" r=\"8\" fill=\"#FF20BE\" fillOpacity=\"0.3\" className=\"animate-pulse\" />\n                </g>\n\n                {/* Admin Block node */}\n                <circle cx=\"200\" cy=\"120\" r=\"4\" fill=\"#38bdf8\" />\n                \n                {/* Stay Partner Hotel */}\n                <circle cx=\"300\" cy=\"140\" r=\"5\" fill=\"#f59e0b\" />\n              </svg>\n\n              {/* Interactive Vector Overlay Cards (Static Legends on Map) */}\n              <div className=\"absolute top-2 left-2 flex flex-col gap-1.5 text-[10px] font-mono text-slate-400 bg-slate-900/90 backdrop-blur-sm p-2 rounded-lg border border-slate-800\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2 h-2 rounded-full bg-purple-500\" />\n                  <span>CUSAT Metro Gate</span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2 h-2 rounded-full bg-pink-500\" />\n                  <span>TECHCON \'26 Hall</span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2 h-2 rounded-full bg-amber-500\" />\n                  <span>Executive Stay</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Map footer with coordinates */}\n            <div className=\"relative z-10 border-t border-slate-800 pt-5 mt-6 flex flex-wrap items-center justify-between gap-3 text-xs\">\n              <div className=\"flex items-center gap-2\">\n                <Compass size={14} className=\"text-purple-400 animate-spin\" style={{ animationDuration: \'6s\' }} />\n                <span className=\"font-mono text-slate-400\">GEO LOC: 9.9447\302\260 N, 76.2244\302\260 E</span>\n              </div>\n              <span className=\"text-[11px] font-sans font-semibold text-white\">Kochi, Kerala, India</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
