  file_change {
    absolute_path_uri: "file:///src/components/TicketPass.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useEffect, useRef, useState } from \'react\';\nimport QRCode from \'qrcode\';\nimport { motion } from \'motion/react\';\nimport { Download, Share2, MapPin, Calendar, Compass, User, Printer } from \'lucide-react\';\nimport { AttendeeRegistration } from \'../types\';\n\ninterface TicketPassProps {\n  registration: AttendeeRegistration;\n  onBackToHome: () => void;\n}\n\nexport default function TicketPass({ registration, onBackToHome }: TicketPassProps) {\n  const [qrUrl, setQrUrl] = useState<string>(\'\');\n  const ticketRef = useRef<HTMLDivElement | null>(null);\n  const qrCanvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  useEffect(() => {\n    // Compile QR payload securely\n    const qrPayload = JSON.stringify({\n      id: registration.id,\n      name: registration.fullName,\n      phone: registration.mobileNumber,\n      email: registration.email,\n      token: registration.verificationToken\n    });\n\n    // Generate local QR URL for <img> rendering\n    QRCode.toDataURL(qrPayload, {\n      width: 250,\n      margin: 1.5,\n      color: {\n        dark: \'#0f172a\', // deep slate\n        light: \'#ffffff\' // white\n      }\n    }, (err, url) => {\n      if (!err && url) {\n        setQrUrl(url);\n      }\n    });\n\n    // Generate to standalone canvas if ref exists (for export drawing)\n    if (qrCanvasRef.current) {\n      QRCode.toCanvas(qrCanvasRef.current, qrPayload, {\n        width: 180,\n        margin: 1\n      });\n    }\n  }, [registration]);\n\n  const handleDownloadPNG = () => {\n    // Generate an incredibly high quality PNG using HTML5 canvas drawing\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = 640;\n    canvas.height = 960;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    // Fill background\n    const bgGrad = ctx.createLinearGradient(0, 0, 0, 960);\n    bgGrad.addColorStop(0, \'#0f172a\'); // slate dark\n    bgGrad.addColorStop(1, \'#1e1b4b\'); // deep indigo\n    ctx.fillStyle = bgGrad;\n    ctx.fillRect(0, 0, 640, 960);\n\n    // Subtle Grid overlay on ticket export\n    ctx.strokeStyle = \'rgba(255, 255, 255, 0.02)\';\n    ctx.lineWidth = 1;\n    for (let x = 0; x < 640; x += 30) {\n      ctx.beginPath();\n      ctx.moveTo(x, 0);\n      ctx.lineTo(x, 960);\n      ctx.stroke();\n    }\n\n    // Outer border glowing accent lines\n    ctx.strokeStyle = \'#782DFF\';\n    ctx.lineWidth = 4;\n    ctx.strokeRect(10, 10, 620, 940);\n\n    // TECHCON Logo Drawing\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 28px sans-serif\';\n    ctx.fillText(\'TECHCON \\\'26\', 45, 80);\n\n    ctx.fillStyle = \'#FF20BE\';\n    ctx.font = \'bold 12px monospace\';\n    ctx.fillText(\'DEFINING THE FUTURE\', 45, 105);\n\n    // Pass Heading\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 12px monospace\';\n    ctx.fillText(\'OFFICIAL DIGITAL BOARDING PASS\', 370, 80);\n\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'14px monospace\';\n    ctx.fillText(\'ENTRY ID: \' + registration.id, 370, 105);\n\n    // Divider Line\n    ctx.strokeStyle = \'rgba(255, 255, 255, 0.1)\';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(40, 140);\n    ctx.lineTo(600, 140);\n    ctx.stroke();\n\n    // Attendee Name\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'PASSENGER / ATTENDEE\', 45, 185);\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 24px sans-serif\';\n    ctx.fillText(registration.fullName.toUpperCase(), 45, 220);\n\n    // Role Category\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'PASS CATEGORY\', 370, 185);\n    ctx.fillStyle = \'#209CFF\';\n    ctx.font = \'bold 16px monospace\';\n    ctx.fillText(registration.occupation.toUpperCase(), 370, 215);\n\n    // Ticket ID\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'REGISTRATION ID\', 45, 280);\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'16px monospace\';\n    ctx.fillText(registration.id, 45, 310);\n\n    // Ticket Number\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'TICKET SERIAL\', 210, 280);\n    ctx.fillStyle = \'#782DFF\';\n    ctx.font = \'16px monospace\';\n    ctx.fillText(registration.ticketNumber, 210, 310);\n\n    // Seat Zone (based on occupation)\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'SECTOR ZONE\', 370, 280);\n    ctx.fillStyle = \'#ffffff\';\n    const zone = registration.occupation === \'Student\' ? \'ZONE C (STUDENT)\' : \'ZONE A (VIP/DELEGATE)\';\n    ctx.font = \'bold 14px sans-serif\';\n    ctx.fillText(zone, 370, 310);\n\n    // Divider Line 2\n    ctx.beginPath();\n    ctx.moveTo(40, 350);\n    ctx.lineTo(600, 350);\n    ctx.stroke();\n\n    // Venue details\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'LOCATION / VENUE\', 45, 395);\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 14px sans-serif\';\n    ctx.fillText(\'CUSAT, Kochi, Kerala, India\', 45, 425);\n\n    // Date details\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'CONFERENCE DATE\', 370, 395);\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 14px sans-serif\';\n    ctx.fillText(\'15 July 2026\', 370, 425);\n\n    // Organizer details\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';\n    ctx.font = \'bold 11px monospace\';\n    ctx.fillText(\'CONFERENCE ORGANIZER\', 45, 480);\n    ctx.fillStyle = \'#FF20BE\';\n    ctx.font = \'bold 14px sans-serif\';\n    ctx.fillText(\'msf TechFed (Independent Wing)\', 45, 510);\n\n    // Divider Ticket Notch simulator\n    ctx.beginPath();\n    ctx.moveTo(40, 560);\n    ctx.lineTo(600, 560);\n    ctx.stroke();\n\n    // QR Code Area\n    // Draw QR canvas image onto the exporter canvas\n    if (qrCanvasRef.current) {\n      ctx.fillStyle = \'#ffffff\';\n      // Background for QR Code\n      ctx.fillRect(220, 610, 200, 200);\n      ctx.drawImage(qrCanvasRef.current, 230, 620, 180, 180);\n    }\n\n    // QR security label\n    ctx.fillStyle = \'rgba(255, 255, 255, 0.3)\';\n    ctx.font = \'10px monospace\';\n    ctx.textAlign = \'center\';\n    ctx.fillText(\'SCAN SECURE ENCRYPTED KEY AT THE GATE FOR INSTANT CHECK-IN\', 320, 840);\n    ctx.fillText(\'POWERED BY MSF TECHFED SYSTEMS\', 320, 860);\n\n    // Export & Download trigger\n    const url = canvas.toDataURL(\'image/png\');\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `techcon26_boardingpass_${registration.id}.png`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleShareWhatsApp = () => {\n    const text = `Hey! I just registered for TECHCON \'26 (organized by msf TechFed). Here is my official Entry Pass Boarding ID: *${registration.id}*. See you there at CUSAT, Kochi on July 15, 2026! Join here: ${window.location.origin}`;\n    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;\n    window.open(url, \'_blank\');\n  };\n\n  return (\n    <div id=\"registration-success-pane\" className=\"w-full max-w-4xl mx-auto py-12 px-6\">\n      \n      {/* Hidden QR canvas used for high resolution exporter */}\n      <canvas ref={qrCanvasRef} className=\"hidden\" />\n\n      {/* Intro Header */}\n      <div className=\"text-center max-w-lg mx-auto mb-10 select-none\">\n        <div className=\"w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 mx-auto mb-4 animate-bounce\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\" className=\"w-6 h-6\">\n            <polyline points=\"20 6 9 17 4 12\" />\n          </svg>\n        </div>\n        <h2 className=\"text-2xl sm:text-3xl font-sans font-bold text-slate-900 tracking-tight\">\n          Registration Complete!\n        </h2>\n        <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 mt-2\">\n          Your seat has been securely locked. Below is your official holographic digital boarding pass. Save this card on your phone to scan at the gate check-in.\n        </p>\n      </div>\n\n      {/* Grid: Pass Card and Exporter Buttons */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Column: Custom Apple Wallet / Boarding Pass */}\n        <div className=\"md:col-span-7 flex justify-center\">\n          <div \n            ref={ticketRef}\n            id=\"boarding-pass-print\"\n            className=\"w-full max-w-[360px] relative bg-slate-950 text-white rounded-[28px] shadow-2xl border border-purple-500/30 overflow-hidden font-sans flex flex-col justify-between p-6 hover:shadow-purple-500/10 transition-shadow duration-500\"\n          >\n            {/* Cutout notch overlays for tickets */}\n            <div className=\"absolute -left-3 top-[55%] w-6 h-6 rounded-full bg-white border-r border-slate-950 z-10\" />\n            <div className=\"absolute -right-3 top-[55%] w-6 h-6 rounded-full bg-white border-l border-slate-950 z-10\" />\n\n            {/* Inner background glow reflection */}\n            <div className=\"absolute w-56 h-56 rounded-full bg-purple-600/10 blur-[60px] -top-10 -right-10 pointer-events-none\" />\n            <div className=\"absolute w-44 h-44 rounded-full bg-pink-500/10 blur-[50px] -bottom-10 -left-10 pointer-events-none\" />\n\n            {/* Pass Header */}\n            <div className=\"flex items-center justify-between border-b border-white/10 pb-4 mb-4 select-none\">\n              <div className=\"flex flex-col\">\n                <span className=\"font-sans text-[11px] tracking-[0.2em] font-bold text-white uppercase leading-none\">\n                  TECHCON \'26\n                </span>\n                <span className=\"text-[7px] font-mono tracking-[0.2em] text-pink-500 uppercase leading-none mt-1\">\n                  Defining the Future\n                </span>\n              </div>\n              <div className=\"flex flex-col items-end\">\n                <span className=\"text-[7px] font-mono tracking-widest text-white/40 uppercase\">ENTRY PASS</span>\n                <span className=\"text-[10px] font-mono text-purple-400 font-bold mt-0.5\">{registration.id}</span>\n              </div>\n            </div>\n\n            {/* Primary Pass Data: Name & Role */}\n            <div className=\"space-y-4 mb-5\">\n              <div>\n                <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">PASSENGER / ATTENDEE</span>\n                <span className=\"text-lg font-bold font-sans tracking-tight text-white block truncate uppercase mt-0.5\">\n                  {registration.fullName}\n                </span>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">PASS CATEGORY</span>\n                  <span className=\"text-xs font-semibold font-mono text-purple-300 mt-0.5 block truncate\">\n                    {registration.occupation.toUpperCase()}\n                  </span>\n                </div>\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">BOARDING SECTOR</span>\n                  <span className=\"text-xs font-semibold font-sans text-slate-300 mt-0.5 block truncate\">\n                    {registration.occupation === \'Student\' ? \'ZONE C (STUDENT)\' : \'ZONE A (VIP)\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Dashed notch indicator */}\n            <div className=\"border-t border-dashed border-white/10 my-1 py-3\" />\n\n            {/* Secondary Pass Data: Venue, Date, Serial */}\n            <div className=\"space-y-4 mb-6\">\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">LOCATION</span>\n                  <span className=\"text-xs font-semibold text-white mt-0.5 block truncate\">\n                    CUSAT, Kochi\n                  </span>\n                </div>\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">DATE</span>\n                  <span className=\"text-xs font-semibold text-white mt-0.5 block truncate\">\n                    15 July 2026\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">TICKET SERIAL</span>\n                  <span className=\"text-[11px] font-mono text-pink-400 font-semibold mt-0.5 block truncate\">\n                    {registration.ticketNumber}\n                  </span>\n                </div>\n                <div>\n                  <span className=\"text-[8px] font-mono tracking-widest text-white/30 uppercase block\">ORGANIZER</span>\n                  <span className=\"text-xs font-sans text-slate-300 mt-0.5 block truncate\">\n                    msf TechFed\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Section: Embedded Secure QR Image */}\n            <div className=\"bg-white p-4 rounded-2xl flex flex-col items-center justify-center mb-1 shadow-inner relative\">\n              {qrUrl ? (\n                <img \n                  src={qrUrl} \n                  alt=\"Boarding Pass QR Code\" \n                  className=\"w-36 h-36 filter drop-shadow-sm select-none\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              ) : (\n                <div className=\"w-36 h-36 bg-slate-100 rounded-lg flex items-center justify-center animate-pulse\">\n                  <span className=\"text-[10px] font-mono text-slate-400\">LOADING QR...</span>\n                </div>\n              )}\n              <span className=\"text-[7px] font-mono text-slate-400 tracking-wider text-center block mt-2.5 uppercase\">\n                ENCRYPTED GATE VERIFICATION SECURE KEY\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Interactive control actions */}\n        <div className=\"md:col-span-5 flex flex-col gap-4\">\n          <div className=\"bg-slate-50 border border-slate-100 p-6 rounded-[28px] space-y-4\">\n            <h3 className=\"text-sm font-mono tracking-widest text-slate-400 uppercase font-semibold\">TICKET CONSOLE</h3>\n            \n            {/* Download Ticket PNG */}\n            <button\n              onClick={handleDownloadPNG}\n              className=\"w-full flex items-center justify-between p-4 bg-white hover:bg-purple-50 border border-slate-150 hover:border-purple-300 rounded-2xl font-sans font-semibold text-xs text-slate-800 transition-all duration-300 hover:shadow-sm\"\n            >\n              <span className=\"flex items-center gap-2.5\">\n                <Download size={15} className=\"text-purple-600\" />\n                <span>Save Offline (PNG Wallet Pass)</span>\n              </span>\n              <span className=\"text-[10px] font-mono text-purple-500\">640 x 960 px</span>\n            </button>\n\n            {/* Print or Save as PDF */}\n            <button\n              onClick={handlePrint}\n              className=\"w-full flex items-center justify-between p-4 bg-white hover:bg-pink-50 border border-slate-150 hover:border-pink-300 rounded-2xl font-sans font-semibold text-xs text-slate-800 transition-all duration-300 hover:shadow-sm\"\n            >\n              <span className=\"flex items-center gap-2.5\">\n                <Printer size={15} className=\"text-pink-500\" />\n                <span>Print / Export PDF</span>\n              </span>\n              <span className=\"text-[10px] font-mono text-pink-500\">A4 Document</span>\n            </button>\n\n            {/* Share to WhatsApp */}\n            <button\n              onClick={handleShareWhatsApp}\n              className=\"w-full flex items-center justify-between p-4 bg-white hover:bg-emerald-50 border border-slate-150 hover:border-emerald-300 rounded-2xl font-sans font-semibold text-xs text-slate-800 transition-all duration-300 hover:shadow-sm\"\n            >\n              <span className=\"flex items-center gap-2.5\">\n                <Share2 size={15} className=\"text-emerald-500\" />\n                <span>Share Entry ID to WhatsApp</span>\n              </span>\n              <span className=\"text-[10px] font-mono text-emerald-500\">WhatsApp URL</span>\n            </button>\n          </div>\n\n          {/* Quick Checklist alert */}\n          <div className=\"p-5 bg-purple-50/50 border border-purple-100/50 rounded-2xl text-xs text-purple-750 space-y-2 select-none\">\n            <span className=\"font-mono font-semibold block uppercase text-[10px] text-purple-600\">IMPORTANT FOR PASS PASSENGERS:</span>\n            <ul className=\"list-disc pl-4 space-y-1 text-slate-600\">\n              <li>Keep this QR code on your mobile phone upon arriving at the main gate at CUSAT.</li>\n              <li>A digital attendance tracker will verify your badge securely.</li>\n              <li>Entry is strictly non-transferable and limited to one entry check-in per pass.</li>\n            </ul>\n          </div>\n\n          <button\n            onClick={onBackToHome}\n            className=\"w-full py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-700 font-sans font-semibold text-sm rounded-2xl transition-colors text-center\"\n          >\n            RETURN TO HOMEPAGE\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    }
