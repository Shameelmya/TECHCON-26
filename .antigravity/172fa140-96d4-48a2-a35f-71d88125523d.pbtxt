  file_change {
    absolute_path_uri: "file:///src/components/RegistrationForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { User, Phone, Mail, Award, BookOpen, Coffee, Check, AlertCircle } from \'lucide-react\';\nimport { AttendeeRegistration } from \'../types\';\nimport { saveRegistration } from \'../utils/db\';\n\ninterface RegistrationFormProps {\n  onSuccess: (reg: AttendeeRegistration) => void;\n  onCancel: () => void;\n}\n\nconst DISTRICTS_KERALA = [\n  \'Ernakulam\', \'Thiruvananthapuram\', \'Kozhikode\', \'Thrissur\', \'Kottayam\', \n  \'Alappuzha\', \'Kollam\', \'Malappuram\', \'Palakkad\', \'Kannur\', \n  \'Kasaragod\', \'Idukki\', \'Wayanad\', \'Pathanamthitta\', \'Other State\'\n];\n\nconst TECH_INTERESTS_LIST = [\n  \'AI\', \'ML\', \'Cyber Security\', \'Cloud\', \'IoT\', \'Robotics\', \n  \'Web\', \'Mobile\', \'Electronics\', \'Blockchain\', \'Data Science\', \'AR\', \'VR\'\n];\n\nexport default function RegistrationForm({ onSuccess, onCancel }: RegistrationFormProps) {\n  const [step, setStep] = useState(1);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  // Form Field States\n  const [fullName, setFullName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [mobileNumber, setMobileNumber] = useState(\'\');\n  const [whatsAppNumber, setWhatsAppNumber] = useState(\'\');\n  const [age, setAge] = useState<number>(22);\n  const [gender, setGender] = useState(\'Male\');\n  const [district, setDistrict] = useState(\'Ernakulam\');\n  const [state, setState] = useState(\'Kerala\');\n  const [country, setCountry] = useState(\'India\');\n  \n  const [occupation, setOccupation] = useState<\'Student\' | \'Working Professional\' | \'Entrepreneur\' | \'Faculty\' | \'Research Scholar\' | \'Other\'>(\'Student\');\n  \n  // Conditional Student fields\n  const [institution, setInstitution] = useState(\'\');\n  const [course, setCourse] = useState(\'\');\n  const [department, setDepartment] = useState(\'\');\n  const [year, setYear] = useState(\'Final Year\');\n\n  // Conditional Professional fields\n  const [company, setCompany] = useState(\'\');\n  const [profession, setProfession] = useState(\'\');\n  const [industry, setIndustry] = useState(\'\');\n\n  // Preferences & Interests\n  const [selectedInterests, setSelectedInterests] = useState<string[]>([]);\n  const [emergencyContact, setEmergencyContact] = useState(\'\');\n  const [foodPreference, setFoodPreference] = useState<\'Veg\' | \'Non-Veg\' | \'Vegan\' | \'Jain\' | \'None\'>(\'None\');\n  const [accessibilityRequirement, setAccessibilityRequirement] = useState(\'\');\n  const [consent, setConsent] = useState(false);\n\n  const toggleInterest = (interest: string) => {\n    if (selectedInterests.includes(interest)) {\n      setSelectedInterests(selectedInterests.filter(i => i !== interest));\n    } else {\n      setSelectedInterests([...selectedInterests, interest]);\n    }\n  };\n\n  const handleNextStep = () => {\n    setErrorMsg(null);\n\n    // Validation for Step 1\n    if (step === 1) {\n      if (!fullName.trim()) return setErrorMsg(\'Please enter your full name\');\n      if (!email.trim() || !email.includes(\'@\')) return setErrorMsg(\'Please enter a valid email address\');\n      if (!mobileNumber.trim()) return setErrorMsg(\'Please enter your mobile number\');\n      if (!whatsAppNumber.trim()) return setErrorMsg(\'Please enter your WhatsApp number\');\n      if (age < 12 || age > 90) return setErrorMsg(\'Please enter a valid age\');\n    }\n\n    // Validation for Step 2\n    if (step === 2) {\n      if (occupation === \'Student\') {\n        if (!institution.trim()) return setErrorMsg(\'Please enter your institution name\');\n        if (!course.trim()) return setErrorMsg(\'Please enter your course (e.g. B.Tech)\');\n        if (!department.trim()) return setErrorMsg(\'Please enter your department\');\n      } else {\n        if (!company.trim()) return setErrorMsg(\'Please enter your company / workspace name\');\n        if (!profession.trim()) return setErrorMsg(\'Please enter your job title / profession\');\n      }\n    }\n\n    // Validation for Step 3\n    if (step === 3) {\n      if (selectedInterests.length === 0) return setErrorMsg(\'Select at least one technology interest\');\n      if (!emergencyContact.trim()) return setErrorMsg(\'Emergency contact number is required\');\n      if (foodPreference === \'None\') return setErrorMsg(\'Please select your meal preference\');\n    }\n\n    setStep(prev => prev + 1);\n  };\n\n  const handlePrevStep = () => {\n    setErrorMsg(null);\n    setStep(prev => Math.max(1, prev - 1));\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n\n    if (!consent) {\n      setErrorMsg(\'You must consent to the privacy policies and registration rules\');\n      return;\n    }\n\n    try {\n      const payload = {\n        fullName,\n        email,\n        mobileNumber,\n        whatsAppNumber,\n        age,\n        gender,\n        district,\n        state,\n        country,\n        occupation,\n        // Conditional data\n        institution: occupation === \'Student\' ? institution : undefined,\n        course: occupation === \'Student\' ? course : undefined,\n        department: occupation === \'Student\' ? department : undefined,\n        year: occupation === \'Student\' ? year : undefined,\n        company: occupation !== \'Student\' ? company : undefined,\n        profession: occupation !== \'Student\' ? profession : undefined,\n        industry: occupation !== \'Student\' ? industry : undefined,\n        // Preferences\n        technologyInterests: selectedInterests,\n        emergencyContact,\n        foodPreference,\n        accessibilityRequirement: accessibilityRequirement || \'None\',\n        consent\n      };\n\n      const registrationResult = saveRegistration(payload);\n      onSuccess(registrationResult);\n    } catch (e: any) {\n      setErrorMsg(e.message || \'An unexpected error occurred during saving.\');\n    }\n  };\n\n  return (\n    <div id=\"register-flow\" className=\"w-full max-w-2xl mx-auto bg-white border border-slate-100 p-8 sm:p-10 rounded-[32px] shadow-xl relative overflow-hidden\">\n      \n      {/* Decorative gradient glowing blob inside the form background */}\n      <div className=\"absolute w-44 h-44 rounded-full bg-purple-500/5 blur-2xl -top-10 -right-10 pointer-events-none\" />\n\n      {/* Progress Wizard Header */}\n      <div className=\"mb-8 select-none\">\n        <div className=\"flex items-center justify-between text-xs font-mono text-slate-400 mb-4\">\n          <span className=\"text-purple-600 font-semibold uppercase\">SECURE PORTAL</span>\n          <span>STEP {step} OF 4</span>\n        </div>\n\n        {/* Dynamic Wizard bar */}\n        <div className=\"flex gap-2.5\">\n          {[1, 2, 3, 4].map((num) => (\n            <div \n              key={num} \n              className={`h-[3px] flex-1 rounded-full transition-all duration-500 ${\n                num <= step \n                  ? \'bg-gradient-to-r from-purple-500 to-pink-500 shadow-sm\' \n                  : \'bg-slate-100\'\n              }`} \n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Form Error Message Alert */}\n      <AnimatePresence>\n        {errorMsg && (\n          <motion.div \n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \'auto\' }}\n            exit={{ opacity: 0, height: 0 }}\n            className=\"mb-6 flex items-start gap-2.5 p-4 bg-red-50 border border-red-100 text-red-600 rounded-2xl text-xs\"\n          >\n            <AlertCircle size={15} className=\"shrink-0 mt-0.5\" />\n            <span className=\"font-sans font-medium\">{errorMsg}</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Steps contents */}\n      <form onSubmit={handleSubmit} className=\"space-y-6\">\n        \n        {/* STEP 1: Personal Details */}\n        {step === 1 && (\n          <motion.div\n            initial={{ opacity: 0, x: 15 }}\n            animate={{ opacity: 1, x: 0 }}\n            className=\"space-y-5\"\n          >\n            <div className=\"border-b border-slate-100 pb-3 mb-4\">\n              <h3 className=\"text-lg font-sans font-bold text-slate-900 flex items-center gap-2\">\n                <User size={18} className=\"text-purple-600\" />\n                <span>Personal Profile</span>\n              </h3>\n              <p className=\"text-xs text-slate-400 font-sans mt-0.5\">Let\342\200\231s start with your contact identity details</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n              {/* Full Name */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Full Name</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Anand Krishna\"\n                  value={fullName}\n                  onChange={(e) => setFullName(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n\n              {/* Email */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Email Address</label>\n                <input\n                  type=\"email\"\n                  placeholder=\"e.g. anand@outlook.com\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n\n              {/* Mobile Phone */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Mobile Number</label>\n                <input\n                  type=\"tel\"\n                  placeholder=\"e.g. +91 9845010203\"\n                  value={mobileNumber}\n                  onChange={(e) => setMobileNumber(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n\n              {/* WhatsApp Phone */}\n              <div className=\"flex flex-col gap-1.5\">\n                <div className=\"flex justify-between items-center\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">WhatsApp Number</label>\n                  <button\n                    type=\"button\"\n                    onClick={() => setWhatsAppNumber(mobileNumber)}\n                    className=\"text-[9px] font-sans text-purple-600 hover:underline font-semibold\"\n                  >\n                    Same as Mobile\n                  </button>\n                </div>\n                <input\n                  type=\"tel\"\n                  placeholder=\"e.g. +91 9845010203\"\n                  value={whatsAppNumber}\n                  onChange={(e) => setWhatsAppNumber(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n\n              {/* Age */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Age (Years)</label>\n                <input\n                  type=\"number\"\n                  min=\"12\"\n                  max=\"95\"\n                  value={age}\n                  onChange={(e) => setAge(parseInt(e.target.value) || 20)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n\n              {/* Gender */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Gender</label>\n                <select\n                  value={gender}\n                  onChange={(e) => setGender(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none bg-white font-sans text-sm text-slate-800 transition-colors\"\n                >\n                  <option value=\"Male\">Male</option>\n                  <option value=\"Female\">Female</option>\n                  <option value=\"Non-binary\">Non-binary</option>\n                  <option value=\"Prefer not to say\">Prefer not to say</option>\n                </select>\n              </div>\n\n              {/* District of Kerala */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">District</label>\n                <select\n                  value={district}\n                  onChange={(e) => setDistrict(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none bg-white font-sans text-sm text-slate-800 transition-colors\"\n                >\n                  {DISTRICTS_KERALA.map(d => (\n                    <option key={d} value={d}>{d}</option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Country */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Country</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"India\"\n                  value={country}\n                  onChange={(e) => setCountry(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800 transition-colors\"\n                />\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {/* STEP 2: Occupation and Professional data */}\n        {step === 2 && (\n          <motion.div\n            initial={{ opacity: 0, x: 15 }}\n            animate={{ opacity: 1, x: 0 }}\n            className=\"space-y-5\"\n          >\n            <div className=\"border-b border-slate-100 pb-3 mb-4\">\n              <h3 className=\"text-lg font-sans font-bold text-slate-900 flex items-center gap-2\">\n                <BookOpen size={18} className=\"text-purple-600\" />\n                <span>Professional Profile</span>\n              </h3>\n              <p className=\"text-xs text-slate-400 font-sans mt-0.5\">Tell us about your educational or organizational background</p>\n            </div>\n\n            {/* Occupation Select */}\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Select Current Role</label>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2.5\">\n                {[\'Student\', \'Working Professional\', \'Entrepreneur\', \'Faculty\', \'Research Scholar\', \'Other\'].map((role) => (\n                  <button\n                    key={role}\n                    type=\"button\"\n                    onClick={() => setOccupation(role as any)}\n                    className={`py-3 px-4 border rounded-xl text-xs font-sans font-medium transition-all duration-300 ${\n                      occupation === role\n                        ? \'bg-purple-600 border-purple-600 text-white shadow-md\'\n                        : \'bg-white border-slate-200 text-slate-600 hover:border-slate-300\'\n                    }`}\n                  >\n                    {role}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Conditional Fields: Student */}\n            {occupation === \'Student\' ? (\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4\">\n                <div className=\"flex flex-col gap-1.5 col-span-2\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Educational Institution Name</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. CUSAT Kochi\"\n                    value={institution}\n                    onChange={(e) => setInstitution(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Course / Degree</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. B.Tech\"\n                    value={course}\n                    onChange={(e) => setCourse(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Department / Branch</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. Computer Science\"\n                    value={department}\n                    onChange={(e) => setDepartment(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Year of Study</label>\n                  <select\n                    value={year}\n                    onChange={(e) => setYear(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none bg-white font-sans text-sm text-slate-800\"\n                  >\n                    <option value=\"First Year\">First Year</option>\n                    <option value=\"Second Year\">Second Year</option>\n                    <option value=\"Third Year\">Third Year</option>\n                    <option value=\"Final Year\">Final Year</option>\n                    <option value=\"Post-grad\">Postgraduate / Ph.D.</option>\n                  </select>\n                </div>\n              </div>\n            ) : (\n              /* Conditional Fields: Professional/Entrepreneur/Faculty */\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4\">\n                <div className=\"flex flex-col gap-1.5 col-span-2\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Company / University Name</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. TCS Research / IIT Madras\"\n                    value={company}\n                    onChange={(e) => setCompany(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Job Title / Profession</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. Senior Software Architect\"\n                    value={profession}\n                    onChange={(e) => setProfession(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Industry Sector</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. AI research, Healthcare, EdTech\"\n                    value={industry}\n                    onChange={(e) => setIndustry(e.target.value)}\n                    className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                  />\n                </div>\n              </div>\n            )}\n          </motion.div>\n        )}\n\n        {/* STEP 3: Preferences and Tech Interests */}\n        {step === 3 && (\n          <motion.div\n            initial={{ opacity: 0, x: 15 }}\n            animate={{ opacity: 1, x: 0 }}\n            className=\"space-y-5\"\n          >\n            <div className=\"border-b border-slate-100 pb-3 mb-4\">\n              <h3 className=\"text-lg font-sans font-bold text-slate-900 flex items-center gap-2\">\n                <Coffee size={18} className=\"text-purple-600\" />\n                <span>Event Preferences</span>\n              </h3>\n              <p className=\"text-xs text-slate-400 font-sans mt-0.5\">Let\'s configure your attendance choices</p>\n            </div>\n\n            {/* Tech interests chips */}\n            <div className=\"flex flex-col gap-2\">\n              <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Select Technology Interests (Multiple)</label>\n              <div className=\"flex flex-wrap gap-2 pt-1.5\">\n                {TECH_INTERESTS_LIST.map((interest) => {\n                  const isSelected = selectedInterests.includes(interest);\n                  return (\n                    <button\n                      key={interest}\n                      type=\"button\"\n                      onClick={() => toggleInterest(interest)}\n                      className={`py-1.5 px-3.5 border rounded-full text-xs font-sans font-medium transition-all duration-300 flex items-center gap-1.5 ${\n                        isSelected\n                          ? \'bg-gradient-to-r from-purple-500 to-pink-500 border-transparent text-white shadow-sm\'\n                          : \'bg-white border-slate-200 text-slate-600 hover:border-slate-300\'\n                      }`}\n                    >\n                      {isSelected && <Check size={12} />}\n                      <span>{interest}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4\">\n              {/* Food Preference */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Food Preference</label>\n                <select\n                  value={foodPreference}\n                  onChange={(e) => setFoodPreference(e.target.value as any)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none bg-white font-sans text-sm text-slate-800\"\n                >\n                  <option value=\"None\">-- Select preference --</option>\n                  <option value=\"Veg\">Vegetarian Feast</option>\n                  <option value=\"Non-Veg\">Non-Vegetarian Feast</option>\n                  <option value=\"Vegan\">Vegan</option>\n                  <option value=\"Jain\">Jain Meal</option>\n                </select>\n              </div>\n\n              {/* Emergency Contact */}\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Emergency Contact Phone</label>\n                <input\n                  type=\"tel\"\n                  placeholder=\"e.g. +91 9445678912\"\n                  value={emergencyContact}\n                  onChange={(e) => setEmergencyContact(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                />\n              </div>\n\n              {/* Accessibility */}\n              <div className=\"flex flex-col gap-1.5 col-span-2\">\n                <label className=\"text-[11px] font-mono tracking-wider text-slate-400 uppercase font-semibold\">Accessibility Requirements (Optional)</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Wheelchair ramp, Sign-language interpreter assistance\"\n                  value={accessibilityRequirement}\n                  onChange={(e) => setAccessibilityRequirement(e.target.value)}\n                  className=\"w-full px-4 py-3 border border-slate-200 focus:border-purple-500 rounded-xl outline-none font-sans text-sm text-slate-800\"\n                />\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {/* STEP 4: Review and Consent */}\n        {step === 4 && (\n          <motion.div\n            initial={{ opacity: 0, x: 15 }}\n            animate={{ opacity: 1, x: 0 }}\n            className=\"space-y-5\"\n          >\n            <div className=\"border-b border-slate-100 pb-3 mb-4\">\n              <h3 className=\"text-lg font-sans font-bold text-slate-900 flex items-center gap-2\">\n                <Award size={18} className=\"text-purple-600\" />\n                <span>Review & Consent</span>\n              </h3>\n              <p className=\"text-xs text-slate-400 font-sans mt-0.5\">Confirm details and sign off registration</p>\n            </div>\n\n            {/* Structured summary */}\n            <div className=\"p-5 bg-slate-50 border border-slate-100 rounded-2xl space-y-3.5 text-xs font-sans text-slate-600 select-none\">\n              <div className=\"flex justify-between border-b border-slate-100/60 pb-1.5\">\n                <span className=\"font-mono text-slate-400\">FULL NAME</span>\n                <span className=\"font-semibold text-slate-800\">{fullName}</span>\n              </div>\n              <div className=\"flex justify-between border-b border-slate-100/60 pb-1.5\">\n                <span className=\"font-mono text-slate-400\">EMAIL</span>\n                <span className=\"font-semibold text-slate-800\">{email}</span>\n              </div>\n              <div className=\"flex justify-between border-b border-slate-100/60 pb-1.5\">\n                <span className=\"font-mono text-slate-400\">PHONE</span>\n                <span className=\"font-semibold text-slate-800\">{mobileNumber}</span>\n              </div>\n              <div className=\"flex justify-between border-b border-slate-100/60 pb-1.5\">\n                <span className=\"font-mono text-slate-400\">ROLE CATEGORY</span>\n                <span className=\"font-semibold text-slate-800\">{occupation}</span>\n              </div>\n              <div className=\"flex justify-between pb-1.5\">\n                <span className=\"font-mono text-slate-400\">TRACK INTERESTS</span>\n                <span className=\"font-semibold text-slate-800 max-w-[200px] text-right truncate\">\n                  {selectedInterests.join(\', \')}\n                </span>\n              </div>\n            </div>\n\n            {/* Consent input check */}\n            <div className=\"flex items-start gap-3 p-4 bg-slate-50/50 rounded-2xl border border-slate-100/80\">\n              <input\n                id=\"consent-box\"\n                type=\"checkbox\"\n                checked={consent}\n                onChange={(e) => setConsent(e.target.checked)}\n                className=\"w-4.5 h-4.5 accent-purple-600 border-slate-300 rounded cursor-pointer mt-0.5 shrink-0\"\n              />\n              <label htmlFor=\"consent-box\" className=\"text-xs text-slate-500 font-sans leading-relaxed cursor-pointer\">\n                I hereby declare that the details provided are genuine. I consent to receiving official tickets, security alerts, and event updates over Email and WhatsApp. I agree to the privacy policy of msf TechFed and TECHCON \'26.\n              </label>\n            </div>\n          </motion.div>\n        )}\n\n        {/* Action Controls Footer */}\n        <div className=\"flex items-center justify-between gap-4 border-t border-slate-100 pt-6 mt-8 select-none\">\n          {step > 1 ? (\n            <button\n              type=\"button\"\n              onClick={handlePrevStep}\n              className=\"px-6 py-2.5 border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-sans font-medium text-xs rounded-full transition-colors\"\n            >\n              PREVIOUS\n            </button>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={onCancel}\n              className=\"px-6 py-2.5 text-slate-500 hover:text-slate-850 font-sans font-medium text-xs hover:bg-slate-50 rounded-full transition-colors\"\n            >\n              CANCEL\n            </button>\n          )}\n\n          {step < 4 ? (\n            <button\n              type=\"button\"\n              onClick={handleNextStep}\n              className=\"px-8 py-2.5 bg-slate-950 hover:bg-purple-600 text-white font-sans font-medium text-xs rounded-full shadow-md transition-all duration-300\"\n            >\n              NEXT STEP\n            </button>\n          ) : (\n            <button\n              type=\"submit\"\n              className=\"px-10 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-sans font-semibold text-xs rounded-full shadow-lg hover:shadow-xl transition-all duration-300\"\n            >\n              SUBMIT & GENERATE TICKET\n            </button>\n          )}\n        </div>\n\n      </form>\n    </div>\n  );\n}\n"
    }
