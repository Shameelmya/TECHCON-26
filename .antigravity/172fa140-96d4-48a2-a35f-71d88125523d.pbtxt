  file_change {
    absolute_path_uri: "file:///src/components/About.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport { Target, Eye, Sparkles, Network, Lightbulb, Users } from \'lucide-react\';\n\nexport default function About() {\n  const pillars = [\n    {\n      icon: <Target className=\"text-purple-600\" size={20} />,\n      title: \'Our Mission\',\n      desc: \'To establish an ecosystem that cultivates futuristic technical expertise, nurtures pathbreaking innovations, and drives collaboration across academic and industrial borders.\',\n    },\n    {\n      icon: <Eye className=\"text-pink-600\" size={20} />,\n      title: \'Our Vision\',\n      desc: \'To position Kerala on the international map of advanced engineering and digital thought leadership, setting standards for open-source research and youth tech-empowerment.\',\n    },\n    {\n      icon: <Sparkles className=\"text-blue-600\" size={20} />,\n      title: \'Innovation Lab\',\n      desc: \'An active physical and digital sandbox exploring advanced concepts in machine intelligence, robotics, distributed ledger technology, and secure micro-computing.\',\n    },\n    {\n      icon: <Network className=\"text-indigo-600\" size={20} />,\n      title: \'Collaboration Network\',\n      desc: \'Connecting thousands of passionate engineers, academic scholars, industry mentors, and product visionaries to facilitate horizontal peer-to-peer knowledge transfers.\',\n    },\n  ];\n\n  return (\n    <section \n      id=\"about\" \n      className=\"py-24 sm:py-32 bg-white px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Subtle light background overlays */}\n      <div className=\"absolute w-96 h-96 rounded-full bg-slate-50 blur-[80px] top-1/3 -left-48 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto\">\n        \n        {/* Core Layout: Grid for Editorial Presentation of TECHCON */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24\">\n          \n          {/* Header left */}\n          <div className=\"lg:col-span-5\">\n            <span className=\"text-xs font-mono font-semibold tracking-widest text-purple-600 uppercase block mb-3\">\n              ABOUT THE CONFERENCE\n            </span>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-sans font-bold tracking-tight text-slate-900 leading-tight mb-6\">\n              Defining the Digital Frontiers of Tomorrow.\n            </h2>\n            <p className=\"text-sm font-sans text-slate-500 leading-relaxed max-w-md\">\n              Organized by <span className=\"font-semibold text-slate-800\">msf TechFed</span>, TECHCON \'26 is the flag-bearer of next-generation technical gatherings. \n              Held at the historical CUSAT campus in Kochi, this event serves as a focal point where visionary concepts morph into sustainable tech infrastructure.\n            </p>\n          </div>\n\n          {/* Description right */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            <p className=\"text-lg sm:text-xl font-sans text-slate-700 font-light leading-relaxed\">\n              \"TECHCON \'26 is more than a series of presentations; it is a collective sandbox designed to spark action. \n              We are assembling developers, researchers, and creators to define the rules of a highly connected, ethical digital tomorrow.\"\n            </p>\n            <div className=\"border-l-2 border-purple-500 pl-6 my-6 italic text-slate-500 text-sm\">\n              \342\200\224 Organizing Committee, msf TechFed\n            </div>\n            <p className=\"text-sm font-sans text-slate-500 leading-relaxed\">\n              Participants will engage with deep-dive technical sessions covering hyper-scale architectures, embedded robotics, neural computing pipelines, and zero-knowledge cryptography, all formatted into hands-on workshops and highly charged interactive panels.\n            </p>\n          </div>\n        </div>\n\n        {/* Pillars Cards Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-28\">\n          {pillars.map((pillar, i) => (\n            <motion.div\n              key={i}\n              initial={{ opacity: 0, y: 15 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 0.5, delay: i * 0.1 }}\n              className=\"p-6 bg-slate-50/50 hover:bg-white rounded-3xl border border-slate-100 hover:border-slate-200 transition-all duration-300 hover:shadow-md hover-card-glow group\"\n            >\n              <div className=\"w-10 h-10 rounded-full bg-white flex items-center justify-center border border-slate-100 mb-5 group-hover:scale-105 transition-transform\">\n                {pillar.icon}\n              </div>\n              <h3 className=\"text-base font-sans font-semibold text-slate-900 mb-2\">\n                {pillar.title}\n              </h3>\n              <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 leading-relaxed\">\n                {pillar.desc}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Sub-section: About msf TechFed (Minimal layout, extremely clean) */}\n        <div className=\"bg-slate-50/40 border border-slate-100 rounded-[32px] p-8 sm:p-12 lg:p-16 relative overflow-hidden\">\n          {/* Subtle decoration inspired by circuits */}\n          <div className=\"absolute right-0 bottom-0 opacity-[0.03] text-slate-900 pointer-events-none select-none\">\n            <svg viewBox=\"0 0 100 100\" className=\"w-48 h-48\">\n              <path d=\"M 0,50 L 50,50 L 70,70 L 100,70\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"4\" />\n              <circle cx=\"100\" cy=\"70\" r=\"10\" fill=\"currentColor\" />\n            </svg>\n          </div>\n\n          <div className=\"max-w-4xl relative z-10\">\n            <span className=\"text-xs font-mono font-semibold tracking-widest text-slate-400 uppercase block mb-3\">\n              THE ORGANIZER\n            </span>\n            <h3 className=\"text-2xl sm:text-3xl font-sans font-bold text-slate-900 tracking-tight mb-6\">\n              About <span className=\"font-mono text-purple-600\">msf TechFed</span>\n            </h3>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-sm font-sans text-slate-500 leading-relaxed\">\n              <div>\n                <p className=\"mb-4\">\n                  <span className=\"font-medium text-slate-800\">msf TechFed</span> is an independent, non-profit technological wing spearheading digital innovation, professional development, and youth empowerment initiatives globally, with a strong focus in Kerala.\n                </p>\n                <p>\n                  By creating bridges between high-performance software engineering, academic excellence, and modern startups, msf TechFed fosters an open, democratic innovation playground for tomorrow\'s technologists.\n                </p>\n              </div>\n              <div>\n                <ul className=\"space-y-3.5\">\n                  <li className=\"flex items-start gap-2.5\">\n                    <Lightbulb className=\"text-pink-500 shrink-0 mt-0.5\" size={16} />\n                    <span><strong className=\"text-slate-800\">Youth Tech Ecosystems</strong>: Championing incubation centers, student clubs, and tech hackathons across major cities.</span>\n                  </li>\n                  <li className=\"flex items-start gap-2.5\">\n                    <Users className=\"text-blue-500 shrink-0 mt-0.5\" size={16} />\n                    <span><strong className=\"text-slate-800\">Mentorship Programs</strong>: Pairing young collegiate talents with veteran enterprise engineers and CTOs.</span>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "/**"
