  file_change {
    absolute_path_uri: "file:///src/components/Venue.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  MapPin, Navigation, Train, Plane, Compass, \n  Hotel, ArrowRight, Map, Info, AlertTriangle, Shield \n} from \'lucide-react\';\n\nexport default function Venue() {\n  const [activeTab, setActiveTab] = useState<\'metro\' | \'airport\' | \'railway\' | \'stay\'>(\'metro\');\n\n  const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=Cochin+University+of+Science+and+Technology,+Kochi,+Kerala,+India`;\n\n  const tabsInfo = {\n    metro: {\n      icon: <Train className=\"text-brand-purple\" size={18} />,\n      title: \'Kochi Metro Transit\',\n      headline: \'CUSAT Metro Station (Line 1)\',\n      desc: \'The Kochi Metro is the fastest and cleanest transit method. Alight at \"CUSAT Metro Station\", which is located directly at the main entrance gate of the campus. From there, electric autos and shuttles can transport you to the venue auditorium (approx 3 minutes).\',\n      time: \'Frequency: Every 7 minutes\'\n    },\n    airport: {\n      icon: <Plane className=\"text-brand-pink\" size={18} />,\n      title: \'Air Travel Connection\',\n      headline: \'Cochin International Airport (COK)\',\n      desc: \'Located at Nedumbassery, COK airport is approximately 22 kilometers (40 minutes drive) from the CUSAT campus. Registered pre-paid airport cabs, Uber, and airport city-buses are readily available at the arrival terminal.\',\n      time: \'Transit cost: \342\202\271450 - \342\202\271700\'\n    },\n    railway: {\n      icon: <Compass className=\"text-brand-blue\" size={18} />,\n      title: \'Railway Connections\',\n      headline: \'Ernakulam Town (ERN) or Aluva (AWY)\',\n      desc: \'The nearest major railway hubs are Ernakulam Town (North) and Aluva station. ERN is 11 km south of CUSAT, and Aluva is 9 km north. Both stations are directly connected to the Kochi Metro network for instant transit to the campus.\',\n      time: \'Metro travel time: ~15 mins\'\n    },\n    stay: {\n      icon: <Hotel className=\"text-emerald-400\" size={18} />,\n      title: \'Accommodations & Hotels\',\n      headline: \'Premium partner stays near Kalamassery\',\n      desc: \'msf TechFed has secured discounted rooms at premium hotels near CUSAT Kalamassery (including Marriott Kochi, Port Muziris, and local boutique executive suites). Contact the organizing hospitality desk with your Registration ID to lock booking rates.\',\n      time: \'Rooms starting from \342\202\2711,800/night\'\n    }\n  };\n\n  return (\n    <section \n      id=\"venue\" \n      className=\"py-24 sm:py-32 bg-brand-dark border-t border-slate-900 px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Background grids & radial glow blobs */}\n      <div \n        className=\"absolute inset-0 pointer-events-none opacity-[0.02]\" \n        style={{\n          backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n          backgroundSize: \'30px 30px\'\n        }}\n      />\n      \n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-brand-pink/10 to-brand-purple/10 blur-[130px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        \n        {/* Header Title with futuristic layout */}\n        <div className=\"text-center max-w-2xl mx-auto mb-20\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-brand-pink/10 border border-brand-pink/20 rounded-full mb-4\">\n            <Map size={12} className=\"text-brand-pink animate-pulse\" />\n            <span className=\"text-[10px] font-mono tracking-[0.2em] text-brand-pink uppercase font-bold\">\n              TRANSIT COMMAND CENTER\n            </span>\n          </div>\n          \n          <h2 className=\"text-4xl sm:text-5xl font-orbitron font-extrabold tracking-tight text-white mb-5 uppercase\">\n            The Venue: CUSAT, Kochi\n          </h2>\n          \n          <p className=\"text-xs sm:text-sm font-sans text-slate-400 leading-relaxed max-w-xl mx-auto\">\n            The flagship conference is hosted at Cochin University of Science and Technology, Kalamassery. CUSAT stands as Kerala\'s premier technological and academic campus.\n          </p>\n        </div>\n\n        {/* Column layout: Tabs Transit Guide & Vector Map */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Left Column: Interactive Tabbed Transit Guide (Fully Dark/Glassmorphic) */}\n          <div className=\"lg:col-span-6 flex flex-col justify-between bg-brand-navy/50 backdrop-blur-md border border-slate-800/80 p-8 rounded-[32px] shadow-2xl relative overflow-hidden\">\n            {/* Corner visual code markings */}\n            <div className=\"absolute left-0 top-0 p-3 select-none pointer-events-none opacity-20\">\n              <span className=\"font-mono text-[9px] text-slate-400\">LOC.A_TRANSIT_GRID_026</span>\n            </div>\n\n            <div className=\"relative z-10\">\n              {/* Tabs list inside dark background */}\n              <div className=\"flex flex-wrap gap-1.5 mb-8 bg-slate-950 p-1.5 rounded-2xl border border-slate-800/80 w-fit\">\n                {(Object.keys(tabsInfo) as Array<keyof typeof tabsInfo>).map((key) => (\n                  <button\n                    key={key}\n                    onClick={() => setActiveTab(key)}\n                    className={`flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-sans font-semibold transition-all duration-300 ${\n                      activeTab === key\n                        ? \'bg-brand-navy text-white shadow-[0_4px_12px_rgba(120,45,255,0.15)] border border-slate-800\'\n                        : \'text-slate-400 hover:text-white hover:bg-brand-navy/30\'\n                    }`}\n                  >\n                    {tabsInfo[key].icon}\n                    <span className=\"capitalize\">{key}</span>\n                  </button>\n                ))}\n              </div>\n\n              {/* Tab Display Area */}\n              <motion.div\n                key={activeTab}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.3 }}\n                className=\"space-y-4\"\n              >\n                <div className=\"flex items-center gap-2 text-[10px] font-mono text-slate-400 uppercase tracking-wider\">\n                  <MapPin size={13} className=\"text-brand-pink\" />\n                  <span>{tabsInfo[activeTab].title}</span>\n                </div>\n                <h3 className=\"text-2xl font-orbitron font-bold text-white tracking-wide uppercase leading-tight\">\n                  {tabsInfo[activeTab].headline}\n                </h3>\n                <p className=\"text-xs sm:text-[14px] font-sans text-slate-400 leading-relaxed\">\n                  {tabsInfo[activeTab].desc}\n                </p>\n              </motion.div>\n            </div>\n\n            {/* Bottom Actions */}\n            <div className=\"border-t border-slate-900 pt-6 mt-8 flex flex-wrap items-center justify-between gap-4 relative z-10\">\n              <div className=\"flex items-center gap-2 text-xs font-mono text-brand-purple font-semibold bg-brand-purple/10 px-3.5 py-1.5 rounded-xl border border-brand-purple/20\">\n                <Info size={12} />\n                <span>{tabsInfo[activeTab].time}</span>\n              </div>\n\n              <a\n                href={directionsUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-pink text-white font-sans font-bold text-xs rounded-full transition-all duration-300 hover:shadow-[0_4px_16px_rgba(120,45,255,0.3)] hover:-translate-y-0.5\"\n              >\n                <Navigation size={13} className=\"animate-pulse\" />\n                <span>GET DIRECTIONS</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Right Column: Stylized Vector Interactive Transit Map */}\n          <div className=\"lg:col-span-6 bg-[#0c101b] rounded-[32px] p-8 flex flex-col justify-between text-white relative overflow-hidden shadow-2xl border border-slate-800/80\">\n            {/* Soft backdrop glow */}\n            <div className=\"absolute w-72 h-72 rounded-full bg-brand-purple/10 blur-[80px] -top-20 -right-20 pointer-events-none\" />\n\n            {/* Map Header */}\n            <div className=\"relative z-10 mb-6 flex items-center justify-between\">\n              <div>\n                <span className=\"text-[10px] font-mono tracking-widest text-brand-purple uppercase font-bold\">CAMPUS SCHEMATIC SCHEDULING</span>\n                <h4 className=\"text-lg font-orbitron font-extrabold text-white mt-0.5 uppercase tracking-wide\">CUSAT Kalamassery</h4>\n              </div>\n              <span className=\"text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 bg-emerald-500/15 border border-emerald-500/35 px-3 py-1 rounded-full\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n                <span>LIVE LINK ACTIVE</span>\n              </span>\n            </div>\n\n            {/* Stylized Vector Map Graphics */}\n            <div className=\"relative w-full h-52 sm:h-64 bg-slate-950/80 rounded-2xl border border-slate-800/80 p-4 overflow-hidden flex items-center justify-center select-none shadow-inner\">\n              \n              {/* Circuit Grid Background */}\n              <div \n                className=\"absolute inset-0 opacity-[0.03] pointer-events-none\"\n                style={{\n                  backgroundImage: `radial-gradient(#ffffff 1px, transparent 1px)`,\n                  backgroundSize: \'16px 16px\'\n                }}\n              />\n\n              {/* Styled Road Tracks & Connections */}\n              <svg viewBox=\"0 0 400 200\" className=\"w-full h-full text-slate-800\">\n                {/* Major Highway (NH 544) */}\n                <path d=\"M 10,20 L 390,20\" fill=\"none\" stroke=\"#101726\" strokeWidth=\"6\" strokeLinecap=\"round\" />\n                <path d=\"M 10,20 L 390,20\" fill=\"none\" stroke=\"#222f47\" strokeWidth=\"1.2\" strokeDasharray=\"4,4\" />\n                \n                {/* CUSAT Road Branch */}\n                <path d=\"M 200,20 L 200,180\" fill=\"none\" stroke=\"#101726\" strokeWidth=\"4\" strokeLinecap=\"round\" />\n                <path d=\"M 200,80 L 100,110 L 100,160\" fill=\"none\" stroke=\"#101726\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n                <path d=\"M 200,130 L 300,140\" fill=\"none\" stroke=\"#101726\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n\n                {/* Metro Track line */}\n                <path d=\"M 10,12 L 390,12\" fill=\"none\" stroke=\"#782DFF\" strokeWidth=\"2\" strokeOpacity=\"0.4\" />\n                \n                {/* Map Nodes */}\n                {/* Metro Station */}\n                <g className=\"cursor-pointer\">\n                  <circle cx=\"200\" cy=\"20\" r=\"6\" fill=\"#782DFF\" />\n                  <circle cx=\"200\" cy=\"20\" r=\"11\" fill=\"#782DFF\" fillOpacity=\"0.25\" className=\"animate-ping\" />\n                </g>\n\n                {/* CUSAT Main Campus Gate */}\n                <circle cx=\"200\" cy=\"60\" r=\"4\" fill=\"#475569\" />\n\n                {/* Main Venue Hall (Auditorium) */}\n                <g className=\"cursor-pointer animate-[pulse_2s_infinite]\">\n                  <rect x=\"80\" y=\"145\" width=\"40\" height=\"22\" rx=\"4\" fill=\"#FF208E\" />\n                  <circle cx=\"100\" cy=\"156\" r=\"2.5\" fill=\"#ffffff\" />\n                  <circle cx=\"100\" cy=\"156\" r=\"8\" fill=\"#FF208E\" fillOpacity=\"0.4\" className=\"animate-pulse\" />\n                </g>\n\n                {/* Admin Block node */}\n                <circle cx=\"200\" cy=\"120\" r=\"4.5\" fill=\"#209CFF\" />\n                \n                {/* Stay Partner Hotel */}\n                <circle cx=\"300\" cy=\"140\" r=\"5\" fill=\"#10b981\" />\n              </svg>\n\n              {/* Interactive Vector Overlay Cards (Legends on Map) */}\n              <div className=\"absolute top-2.5 left-2.5 flex flex-col gap-1 text-[9px] font-mono text-slate-400 bg-slate-950/90 backdrop-blur-sm p-2 rounded-lg border border-slate-800\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-brand-purple\" />\n                  <span>Metro Entrance Gate</span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-brand-pink animate-pulse\" />\n                  <span>TECHCON \'26 Hall</span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" />\n                  <span>Executive Partner Hotel</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Map footer with coordinates */}\n            <div className=\"relative z-10 border-t border-slate-900 pt-5 mt-6 flex flex-wrap items-center justify-between gap-3 text-xs\">\n              <div className=\"flex items-center gap-2 bg-slate-950/60 border border-slate-900 px-3 py-1.5 rounded-xl\">\n                <Compass size={14} className=\"text-brand-purple animate-spin\" style={{ animationDuration: \'8s\' }} />\n                <span className=\"font-mono text-slate-400\">LATENCY_GPS: 9.9447\302\260 N, 76.2244\302\260 E</span>\n              </div>\n              <span className=\"text-[11px] font-mono text-slate-500 uppercase\">KOCHI, KERALA, INDIA</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
