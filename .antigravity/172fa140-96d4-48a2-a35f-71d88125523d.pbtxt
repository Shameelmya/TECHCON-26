  file_change {
    absolute_path_uri: "file:///src/components/About.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport { \n  Target, Eye, Sparkles, Network, Lightbulb, Users, \n  BookOpen, Cpu, Layers, Award, Terminal, CheckCircle2 \n} from \'lucide-react\';\n\nexport default function About() {\n  const pillars = [\n    {\n      icon: <Target className=\"text-brand-purple\" size={20} />,\n      title: \'Our Mission\',\n      desc: \'To establish an ecosystem that cultivates futuristic technical expertise, nurtures pathbreaking innovations, and drives collaboration across academic and industrial borders.\',\n    },\n    {\n      icon: <Eye className=\"text-brand-pink\" size={20} />,\n      title: \'Our Vision\',\n      desc: \'To position Kerala on the international map of advanced engineering and digital thought leadership, setting standards for open-source research and youth tech-empowerment.\',\n    },\n    {\n      icon: <Sparkles className=\"text-brand-blue\" size={20} />,\n      title: \'Innovation Lab\',\n      desc: \'An active physical and digital sandbox exploring advanced concepts in machine intelligence, robotics, distributed ledger technology, and secure micro-computing.\',\n    },\n    {\n      icon: <Network className=\"text-indigo-500\" size={20} />,\n      title: \'Collaboration Network\',\n      desc: \'Connecting thousands of passionate engineers, academic scholars, industry mentors, and product visionaries to facilitate horizontal peer-to-peer knowledge transfers.\',\n    },\n  ];\n\n  // Specific logo concept values taken directly from the TECHCON brand guidelines images\n  const brandKitDecomposition = [\n    {\n      tag: \"LETTER T\",\n      title: \"Core Foundation\",\n      subtitle: \"Represents Tech, Innovation, Technology, and Transformation as the bedrock.\",\n      icon: <Cpu className=\"text-brand-pink\" size={16} />\n    },\n    {\n      tag: \"LETTER C\",\n      title: \"Assembly & Con\",\n      subtitle: \"Represents Con, Connection, Collaboration, and horizontal Continuity.\",\n      icon: <Network className=\"text-brand-purple\" size={16} />\n    },\n    {\n      tag: \"CIRCUIT LINES\",\n      title: \"Data Pipeline\",\n      subtitle: \"Signifies Network infrastructure, Digital Connectivity, and real-time Data Flow.\",\n      icon: <Terminal className=\"text-brand-blue\" size={16} />\n    },\n    {\n      tag: \"OPEN BOOK / PAGE\",\n      title: \"Scholastic Search\",\n      subtitle: \"The sleek abstract form mimics an open book page, symbolizing learning & academic growth.\",\n      icon: <BookOpen className=\"text-emerald-400\" size={16} />\n    },\n    {\n      tag: \"DOT IN \'O\'\",\n      title: \"Focus & Core\",\n      subtitle: \"The customized \'O\' center dot symbol represents Focus, Precision, and Infinite Possibilities.\",\n      icon: <Layers className=\"text-amber-400\" size={16} />\n    }\n  ];\n\n  return (\n    <section \n      id=\"about\" \n      className=\"py-24 sm:py-32 bg-white px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Subtle background light blob */}\n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-slate-50 blur-[100px] top-1/3 -left-48 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto\">\n        \n        {/* Editorial Title Section */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24\">\n          <div className=\"lg:col-span-5\">\n            <span className=\"text-[11px] font-mono font-bold tracking-[0.25em] text-brand-purple uppercase block mb-3.5\">\n              // ABOUT THE CONFERENCE\n            </span>\n            <h2 className=\"text-4xl sm:text-5xl font-orbitron font-extrabold tracking-tight text-slate-950 uppercase leading-[1.05] mb-6\">\n              Defining the Digital Frontiers.\n            </h2>\n            <p className=\"text-sm font-sans text-slate-500 leading-relaxed max-w-md\">\n              Organized by <span className=\"font-bold text-slate-900 font-sans\">msf TechFed</span>, TECHCON \'26 is the flag-bearer of next-generation technical assemblies. Held at the historic CUSAT campus in Kochi, this physical conclave is where vision morphs into robust code.\n            </p>\n          </div>\n\n          <div className=\"lg:col-span-7 space-y-6 lg:pt-2\">\n            <p className=\"text-xl sm:text-2xl font-display font-light text-slate-700 leading-relaxed\">\n              \"TECHCON \'26 is more than a series of presentations; it is a collective sandbox designed to spark action. We are assembling creators to establish the rulebook of a highly connected digital tomorrow.\"\n            </p>\n            <div className=\"border-l-[3px] border-brand-pink pl-6 my-6 italic text-slate-500 text-sm font-sans\">\n              \342\200\224 Central Organizing Board, msf TechFed\n            </div>\n            <p className=\"text-xs sm:text-[13px] font-mono text-slate-500 leading-relaxed\">\n              Participants will engage with deep-dive technical folds covering distributed high-scale structures, embedded robotics telemetry, neural computing compilers, and zero-trust cryptography.\n            </p>\n          </div>\n        </div>\n\n        {/* Pillars Cards Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-28\">\n          {pillars.map((pillar, i) => (\n            <motion.div\n              key={i}\n              initial={{ opacity: 0, y: 15 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 0.5, delay: i * 0.1 }}\n              className=\"p-6 bg-slate-50/60 hover:bg-white rounded-3xl border border-slate-100 hover:border-slate-200 hover:shadow-lg transition-all duration-300 group\"\n            >\n              <div className=\"w-10 h-10 rounded-full bg-white flex items-center justify-center border border-slate-100 mb-5 group-hover:scale-105 transition-transform\">\n                {pillar.icon}\n              </div>\n              <h3 className=\"text-base font-orbitron font-bold text-slate-950 uppercase tracking-wide mb-2\">\n                {pillar.title}\n              </h3>\n              <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 leading-relaxed\">\n                {pillar.desc}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* NEW ADDITION: Brand Anatomy Module (Matches brand guidelines images exactly) */}\n        <div className=\"mb-28 border border-slate-100 bg-slate-50/30 rounded-[32px] p-8 sm:p-12 relative overflow-hidden\">\n          <div className=\"absolute right-0 top-0 w-80 h-80 bg-gradient-to-bl from-purple-500/5 to-transparent blur-3xl pointer-events-none\" />\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            \n            {/* Left: Vector Brand Kit Demo Logo Lockup */}\n            <div className=\"lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left\">\n              <span className=\"text-[10px] font-mono font-bold tracking-widest text-slate-400 uppercase block mb-3\">\n                VISUAL IDENTITY DECONSTRUCTION\n              </span>\n              <h3 className=\"text-2xl sm:text-3xl font-orbitron font-extrabold text-slate-950 uppercase tracking-wide mb-4\">\n                The Brand Kit Anatomy\n              </h3>\n              <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 leading-relaxed max-w-sm mb-6\">\n                A sleek abstract mark inspired by open knowledge grids, built with futuristic geometric typography and electrical trace pathways.\n              </p>\n              \n              {/* Giant Brand Key Icon */}\n              <div className=\"relative w-40 h-40 flex items-center justify-center bg-slate-950 rounded-3xl border border-slate-800 shadow-xl overflow-hidden group\">\n                <div className=\"absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px] opacity-10\" />\n                <svg viewBox=\"0 0 100 100\" className=\"w-4/5 h-4/5\">\n                  <defs>\n                    <linearGradient id=\"brand-anatomy-grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                      <stop offset=\"0%\" stopColor=\"#FF208E\" />\n                      <stop offset=\"50%\" stopColor=\"#782DFF\" />\n                      <stop offset=\"100%\" stopColor=\"#209CFF\" />\n                    </linearGradient>\n                  </defs>\n                  \n                  {/* Decorative circuit line */}\n                  <path d=\"M 68,22 Q 85,22 88,10\" fill=\"none\" stroke=\"#FF208E\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n                  <path d=\"M 38,72 Q 20,74 12,65\" fill=\"none\" stroke=\"#782DFF\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n                  \n                  {/* Brand T ribbon */}\n                  <path\n                    d=\"M 30,25 C 30,25 45,20 65,22 C 72,23 75,28 72,32 C 68,36 55,38 45,42 C 41,44 38,48 38,55 L 38,72 C 38,79 42,82 48,80 C 56,77 64,68 64,68\"\n                    fill=\"none\"\n                    stroke=\"url(#brand-anatomy-grad)\"\n                    strokeWidth=\"11\"\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                  />\n                  \n                  {/* Outer circle dotted */}\n                  <circle cx=\"50\" cy=\"50\" r=\"44\" fill=\"none\" stroke=\"#782DFF\" strokeWidth=\"1\" strokeDasharray=\"3,3\" className=\"opacity-40\" />\n                </svg>\n              </div>\n            </div>\n\n            {/* Right: Listed brand concepts (Deconstructed) */}\n            <div className=\"lg:col-span-7 space-y-4\">\n              {brandKitDecomposition.map((concept, index) => (\n                <div \n                  key={index} \n                  className=\"flex items-start gap-4 p-4 bg-white rounded-2xl border border-slate-100 hover:border-slate-200 hover:shadow-md transition-all duration-300\"\n                >\n                  <div className=\"w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center border border-slate-100/80 shrink-0 mt-0.5\">\n                    {concept.icon}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-mono text-[9px] font-bold text-brand-purple tracking-widest\">{concept.tag}</span>\n                      <span className=\"text-[10px] text-slate-300 font-mono\">/</span>\n                      <span className=\"text-xs font-orbitron font-bold text-slate-900 uppercase tracking-wide\">{concept.title}</span>\n                    </div>\n                    <p className=\"text-[11px] sm:text-xs font-sans text-slate-500 mt-1 leading-relaxed\">\n                      {concept.subtitle}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n          </div>\n        </div>\n\n        {/* Organizer Section: msf TechFed */}\n        <div className=\"bg-slate-50/50 border border-slate-100 rounded-[32px] p-8 sm:p-12 lg:p-16 relative overflow-hidden\">\n          <div className=\"absolute right-0 bottom-0 opacity-[0.03] text-slate-950 pointer-events-none select-none\">\n            <svg viewBox=\"0 0 100 100\" className=\"w-48 h-48\">\n              <path d=\"M 0,50 L 50,50 L 70,70 L 100,70\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"4\" />\n              <circle cx=\"100\" cy=\"70\" r=\"10\" fill=\"currentColor\" />\n            </svg>\n          </div>\n\n          <div className=\"max-w-4xl relative z-10\">\n            <span className=\"text-[10px] font-mono font-bold tracking-widest text-slate-400 uppercase block mb-3\">\n              THE PARENT ORGANIZER\n            </span>\n            <h3 className=\"text-2xl sm:text-3xl font-orbitron font-extrabold text-slate-950 tracking-wide uppercase mb-6\">\n              About <span className=\"text-brand-purple\">msf TechFed</span>\n            </h3>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-sm font-sans text-slate-500 leading-relaxed\">\n              <div>\n                <p className=\"mb-4\">\n                  <span className=\"font-bold text-slate-950 font-sans\">msf TechFed</span> is an independent, non-profit technological wing spearheading advanced digital innovation, developer training, and open-source ecosystems.\n                </p>\n                <p>\n                  By creating direct vectors between enterprise engineering, academic excellence, and startup incubation, msf TechFed creates horizontal platforms where technology serves democratic development.\n                </p>\n              </div>\n              <div className=\"space-y-4\">\n                <div className=\"flex items-start gap-3 bg-white p-4 rounded-2xl border border-slate-100/60 shadow-sm\">\n                  <CheckCircle2 className=\"text-brand-pink shrink-0 mt-0.5\" size={16} />\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-900 uppercase\">Youth Tech Ecosystems</h5>\n                    <p className=\"text-xs text-slate-500 mt-1 leading-normal\">Championing student code clubs, technical hackathons, and local sandboxes in all major regions.</p>\n                  </div>\n                </div>\n                <div className=\"flex items-start gap-3 bg-white p-4 rounded-2xl border border-slate-100/60 shadow-sm\">\n                  <Award className=\"text-brand-blue shrink-0 mt-0.5\" size={16} />\n                  <div>\n                    <h5 className=\"text-xs font-orbitron font-bold text-slate-900 uppercase\">CTO-Level Mentorship</h5>\n                    <p className=\"text-xs text-slate-500 mt-1 leading-normal\">Pairing young collegiate innovators with veteran technology leaders and enterprise architects.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
