      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport { Brain, ShieldAlert, Zap, Cpu, Share2, Code, FileSearch, Briefcase } from \'lucide-react\';\n\nexport default function WhyAttend() {\n  const cards = [\n    {\n      icon: <Brain className=\"text-pink-500\" size={24} />,\n      title: \'Artificial Intelligence & ML\',\n      subtitle: \'Explore generative neural nets, deep learning compilers, and real-time edge execution pipelines.\',\n      color: \'from-pink-500/10 to-transparent\',\n      borderColor: \'group-hover:border-pink-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(236,72,153,0.1)]\',\n    },\n    {\n      icon: <ShieldAlert className=\"text-purple-500\" size={24} />,\n      title: \'Cyber Security & Cryptography\',\n      subtitle: \'Zero-trust networks, web3 security models, privacy-preserving techniques, and modern exploitation labs.\',\n      color: \'from-purple-500/10 to-transparent\',\n      borderColor: \'group-hover:border-purple-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(120,45,255,0.1)]\',\n    },\n    {\n      icon: <Zap className=\"text-amber-500\" size={24} />,\n      title: \'Innovation Lab\',\n      subtitle: \'Witness the metamorphosis of bold technology concepts into scalable and impactful real-world tools.\',\n      color: \'from-amber-500/10 to-transparent\',\n      borderColor: \'group-hover:border-amber-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(245,158,11,0.1)]\',\n    },\n    {\n      icon: <Cpu className=\"text-blue-500\" size={24} />,\n      title: \'Embedded Robotics\',\n      subtitle: \'Sensory telemetry networks, industrial microcontrollers, autonomous system navigation, and spatial AI.\',\n      color: \'from-blue-500/10 to-transparent\',\n      borderColor: \'group-hover:border-blue-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(32,156,255,0.1)]\',\n    },\n    {\n      icon: <Share2 className=\"text-indigo-500\" size={24} />,\n      title: \'Network & Connectivity\',\n      subtitle: \'Low-latency mesh systems, high-throughput cloud streaming, decentralized ledgers, and edge nodes.\',\n      color: \'from-indigo-500/10 to-transparent\',\n      borderColor: \'group-hover:border-indigo-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(99,102,241,0.1)]\',\n    },\n    {\n      icon: <Code className=\"text-emerald-500\" size={24} />,\n      title: \'Modern Engineering\',\n      subtitle: \'Advanced systems programming (Rust/Go), distributed systems, and real-time database streaming.\',\n      color: \'from-emerald-500/10 to-transparent\',\n      borderColor: \'group-hover:border-emerald-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(16,185,129,0.1)]\',\n    },\n    {\n      icon: <FileSearch className=\"text-cyan-500\" size={24} />,\n      title: \'Academic Research\',\n      subtitle: \'Reviewing cutting-edge research abstracts, student thesis presentations, and peer-reviewed journals.\',\n      color: \'from-cyan-500/10 to-transparent\',\n      borderColor: \'group-hover:border-cyan-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(6,182,212,0.1)]\',\n    },\n    {\n      icon: <Briefcase className=\"text-rose-500\" size={24} />,\n      title: \'Future Tech Careers\',\n      subtitle: \'Dedicated hiring booths, resume workshops, startup pitching battles, and networking lounges.\',\n      color: \'from-rose-500/10 to-transparent\',\n      borderColor: \'group-hover:border-rose-500/30\',\n      glow: \'shadow-[0_0_20px_rgba(244,63,94,0.1)]\',\n    },\n  ];\n\n  return (\n    <section \n      id=\"why-attend\" \n      className=\"py-24 sm:py-32 bg-slate-50/50 px-6 md:px-12 relative overflow-hidden\"\n    >\n      {/* Dynamic light blob background elements */}\n      <div className=\"absolute w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-blue-100/30 to-purple-100/30 blur-[130px] -bottom-40 left-1/3 pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        \n        {/* Header Text */}\n        <div className=\"text-center max-w-xl mx-auto mb-20\">\n          <span className=\"text-xs font-mono font-semibold tracking-widest text-purple-600 uppercase block mb-3\">\n            CONFERENCE TRACKS\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-sans font-bold tracking-tight text-slate-900 mb-5\">\n            Why Attend TECHCON \'26?\n          </h2>\n          <p className=\"text-sm font-sans text-slate-500 leading-relaxed\">\n            Our schedule is structured across eight distinct, high-impact pillars. Immerse yourself in the paradigms and pipelines shaping international digital engineering.\n          </p>\n        </div>\n\n        {/* Dynamic Bento Cards Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {cards.map((card, i) => (\n            <motion.div\n              key={i}\n              initial={{ opacity: 0, y: 15 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 0.5, delay: i * 0.05 }}\n              className={`group relative p-6 bg-white rounded-3xl border border-slate-100 hover:border-slate-200 transition-all duration-300 hover:-translate-y-1 hover:${card.glow} hover-card-glow overflow-hidden flex flex-col justify-between`}\n            >\n              {/* Inner floating soft gradient background blob */}\n              <div className={`absolute inset-0 bg-gradient-to-b ${card.color} opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none`} />\n\n              <div className=\"relative z-10\">\n                {/* Custom glowing icon plate */}\n                <div className=\"w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center border border-slate-100 mb-6 group-hover:scale-110 group-hover:bg-white transition-all duration-300\">\n                  {card.icon}\n                </div>\n\n                <h3 className=\"text-base font-sans font-semibold text-slate-900 group-hover:text-slate-950 transition-colors mb-2.5\">\n                  {card.title}\n                </h3>\n\n                <p className=\"text-xs sm:text-[13px] font-sans text-slate-500 leading-relaxed mb-6\">\n                  {card.subtitle}\n                </p>\n              </div>\n\n              {/* Little detail indicator at bottom of card */}\n              <div className=\"relative z-10 flex items-center gap-1.5 text-[11px] font-mono font-medium text-slate-400 group-hover:text-purple-600 transition-colors\">\n                <span>0{i + 1}</span>\n                <span className=\"w-4 h-[1px] bg-slate-200 group-hover:bg-purple-600 transition-all duration-300 group-hover:w-8\" />\n                <span className=\"opacity-0 group-hover:opacity-100 transition-all duration-300\">DISCOVER</span>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
