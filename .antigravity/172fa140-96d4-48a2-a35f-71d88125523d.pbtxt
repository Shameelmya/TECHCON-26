        lines {
          text: "  if (typeof window === \'undefined\') return [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const stored = localStorage.getItem(STORAGE_KEY);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!stored) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
