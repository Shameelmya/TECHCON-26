rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@msftech26.com';
    }

    function isAnonymousUser() {
      return request.auth != null;
    }

    match /registrations/{regId} {
      // Any authenticated user (including anonymous) can create a registration
      // Payload validation happens heavily on the client, but here we enforce basic presence
      allow create: if isAnonymousUser() && request.resource.data.keys().hasAll(['fullName', 'mobileNumber']);
      
      // ONLY Admins can view, update (e.g. checkIn), or delete registrations
      allow read, update, delete: if isAdmin();
    }

    match /settings/counters {
      // The counters document can be read by anyone (to get the current count)
      allow read: if true;
      // ONLY the registration transaction can increment it securely
      allow update: if isAnonymousUser() 
        && request.resource.data.registrationCount == resource.data.registrationCount + 1;
      allow write: if isAdmin();
    }

    match /settings/stats {
      allow read: if true;
      // Allow atomic updates by anonymous users during registration (using increment)
      allow update: if isAnonymousUser();
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true; // Temporarily relaxed for legacy admin access
    }

    match /volunteers/{volunteerId} {
      // Volunteers can create their own registration
      allow create: if isAnonymousUser();
      allow read, update, delete: if isAdmin();
    }

    match /campus_ambassadors/{ambassadorId} {
      allow create: if isAnonymousUser();
      allow read, update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
